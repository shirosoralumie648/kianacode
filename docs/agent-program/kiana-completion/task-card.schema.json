{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-agent-task-card.v1.schema.json",
  "title": "Kiana Agent Task Card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "title",
    "outcome",
    "domain_id",
    "ownership_packages",
    "wave",
    "task_type",
    "risk",
    "depends_on",
    "candidate_write_paths",
    "required_approvals",
    "required_artifacts",
    "reference_capabilities",
    "verification",
    "acceptance",
    "requires_approval",
    "exclusive",
    "status",
    "blocked_reason"
  ],
  "properties": {
    "schema": {
      "const": "kiana.agent-task-card.v1"
    },
    "task_id": {
      "type": "string",
      "pattern": "^(E[0-9]{2}|D[0-9]{2}-[0-9]{2})$"
    },
    "title": {
      "type": "string",
      "minLength": 4
    },
    "outcome": {
      "type": "string",
      "minLength": 12
    },
    "domain_id": {
      "type": "string",
      "pattern": "^(GLOBAL|D(0[1-9]|1[0-8]))$"
    },
    "ownership_packages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^P(0[1-9]|[12][0-9]|30)$"
      }
    },
    "wave": {
      "enum": [
        "W0",
        "W1",
        "W2",
        "W3",
        "W4",
        "W5",
        "W6"
      ]
    },
    "task_type": {
      "enum": [
        "baseline",
        "reference_audit",
        "behavior_preserving_refactor",
        "contract",
        "control_plane",
        "feature",
        "integration",
        "verification",
        "release"
      ]
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "depends_on": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(E[0-9]{2}|D[0-9]{2}-[0-9]{2})$"
      }
    },
    "candidate_write_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "expected_initial",
        "expected_success"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 4
        },
        "expected_initial": {
          "type": "string",
          "minLength": 4,
          "description": "Initial implementation or verification state only; must not require a pre-implementation failing test."
        },
        "expected_success": {
          "type": "string",
          "minLength": 4
        }
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 8
      }
    },
    "requires_approval": {
      "type": "boolean"
    },
    "exclusive": {
      "type": "boolean"
    },
    "status": {
      "enum": [
        "ready",
        "blocked"
      ]
    },
    "blocked_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "reference_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "required_artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "required_approvals": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "blocked_reason": {
            "type": "string",
            "minLength": 8
          }
        }
      },
      "else": {
        "properties": {
          "blocked_reason": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "requires_approval": {
            "const": true
          }
        },
        "required": [
          "requires_approval"
        ]
      },
      "then": {
        "properties": {
          "required_approvals": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
