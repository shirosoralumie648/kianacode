{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-app-server-model-current.v1.schema.json",
  "title": "Kiana App Server Current Model v1",
  "type": "object",
  "required": [
    "schema",
    "workspace",
    "configured",
    "source",
    "provider_id",
    "model_id",
    "profile"
  ],
  "properties": {
    "schema": {
      "const": "kiana.app-server.model-current.v1"
    },
    "workspace": {
      "type": "string",
      "minLength": 1
    },
    "configured": {
      "type": "boolean"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "provider_id": {
      "type": "string",
      "minLength": 1
    },
    "model_id": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "type": "object",
      "required": [
        "provider_id",
        "provider_display_name",
        "model_id",
        "supports_tools",
        "supports_streaming",
        "streaming_mode",
        "native_streaming",
        "supports_vision",
        "supports_structured_output",
        "context_window"
      ],
      "properties": {
        "provider_id": {
          "type": "string",
          "minLength": 1
        },
        "provider_display_name": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "supports_tools": {
          "type": "boolean"
        },
        "supports_streaming": {
          "type": "boolean"
        },
        "streaming_mode": {
          "enum": [
            "native",
            "synthetic",
            "none"
          ]
        },
        "native_streaming": {
          "type": "boolean"
        },
        "supports_vision": {
          "type": "boolean"
        },
        "supports_structured_output": {
          "type": "boolean"
        },
        "context_window": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
