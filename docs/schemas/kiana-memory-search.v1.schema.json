{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-memory-search.v1.schema.json",
  "title": "Kiana Memory Search v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "store_file", "query", "terms", "limit", "record_count", "hits"],
  "properties": {
    "schema": { "const": "kiana.memory-search.v1" },
    "store_file": { "type": "string", "minLength": 1 },
    "query": { "type": "string", "minLength": 1 },
    "terms": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "limit": { "type": "integer", "minimum": 1 },
    "record_count": { "type": "integer", "minimum": 0 },
    "hits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "source",
          "score",
          "matched_terms",
          "text",
          "redaction_count",
          "created_at_ms"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^mem-[0-9]+-[0-9a-f]{16}$" },
          "kind": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
          "source": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
          "score": { "type": "integer", "minimum": 1 },
          "matched_terms": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "text": { "type": "string", "minLength": 1 },
          "redaction_count": { "type": "integer", "minimum": 0 },
          "created_at_ms": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
