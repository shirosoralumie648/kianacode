{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-source-control-proof.v1.schema.json",
  "title": "Kiana Source Control Proof v1",
  "type": "object",
  "required": [
    "schema",
    "version",
    "status",
    "accepted",
    "accepted_by",
    "accepted_at",
    "remote_url",
    "commit",
    "release_tag",
    "tagged_commit",
    "pushed",
    "reviewed"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "accepted"
          }
        }
      },
      "then": {
        "properties": {
          "accepted": {
            "const": true
          },
          "accepted_by": {
            "minLength": 1
          },
          "accepted_at": {
            "minLength": 1
          },
          "remote_url": {
            "minLength": 1
          },
          "commit": {
            "pattern": "^[0-9a-f]{40}$"
          },
          "tagged_commit": {
            "pattern": "^[0-9a-f]{40}$"
          },
          "pushed": {
            "const": true
          },
          "reviewed": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "accepted": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "accepted"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": ["local_rc_only", "blocked"]
          }
        }
      },
      "then": {
        "properties": {
          "accepted": {
            "const": false
          }
        }
      }
    }
  ],
  "properties": {
    "schema": {
      "const": "kiana.source-control-proof.v1"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["accepted", "local_rc_only", "blocked"]
    },
    "accepted": {
      "type": "boolean"
    },
    "accepted_by": {
      "type": "string"
    },
    "accepted_at": {
      "type": "string"
    },
    "remote_url": {
      "type": "string"
    },
    "commit": {
      "type": "string"
    },
    "release_tag": {
      "type": "string",
      "pattern": "^v[0-9]+[.][0-9]+[.][0-9]+$"
    },
    "tagged_commit": {
      "type": "string"
    },
    "pushed": {
      "type": "boolean"
    },
    "reviewed": {
      "type": "boolean"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
