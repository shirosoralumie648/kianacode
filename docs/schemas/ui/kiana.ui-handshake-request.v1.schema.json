{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kiana.ui-handshake-request.v1",
  "title": "Kiana UI handshake request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "client_version",
    "surface"
  ],
  "properties": {
    "schema": {
      "const": "kiana.ui-handshake-request.v1"
    },
    "client_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "surface": {
      "enum": [
        "cli",
        "workbench",
        "web",
        "desktop",
        "ide"
      ]
    },
    "requested_capabilities": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/capabilityRequest"
      }
    },
    "known_instance_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 256
    },
    "known_authority_epoch": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    }
  },
  "$defs": {
    "capabilityRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "feature_version"
      ],
      "properties": {
        "capability_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "feature_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    }
  },
  "examples": [
    {
      "schema": "kiana.ui-handshake-request.v1",
      "client_version": "0.1.0",
      "surface": "web",
      "requested_capabilities": [
        {
          "capability_id": "ui.feed.v1",
          "feature_version": "1.0"
        }
      ],
      "known_instance_id": "instance-example",
      "known_authority_epoch": 7
    }
  ]
}
