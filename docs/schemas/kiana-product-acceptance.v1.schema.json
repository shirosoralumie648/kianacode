{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-product-acceptance.v1.schema.json",
  "title": "Kiana Product Acceptance v1",
  "type": "object",
  "required": [
    "schema",
    "version",
    "status",
    "accepted",
    "accepted_by",
    "accepted_at",
    "scope",
    "workflows"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "accepted"
          }
        }
      },
      "then": {
        "properties": {
          "accepted": {
            "const": true
          },
          "accepted_by": {
            "minLength": 1
          },
          "accepted_at": {
            "minLength": 1
          },
          "scope": {
            "minLength": 1
          },
          "workflows": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "accepted": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "accepted"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": ["headless_smoke_only", "blocked"]
          }
        }
      },
      "then": {
        "properties": {
          "accepted": {
            "const": false
          }
        }
      }
    }
  ],
  "properties": {
    "schema": {
      "const": "kiana.product-acceptance.v1"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["accepted", "headless_smoke_only", "blocked"]
    },
    "accepted": {
      "type": "boolean"
    },
    "accepted_by": {
      "type": "string"
    },
    "accepted_at": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "workflows": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
