{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-remote-code-session-smoke.v1.schema.json",
  "title": "Kiana Remote Code Session Smoke v1",
  "type": "object",
  "required": [
    "schema",
    "status",
    "checked_at",
    "session_id",
    "api_base_url",
    "sdk_url",
    "expires_in",
    "worker_epoch"
  ],
  "properties": {
    "schema": {
      "const": "kiana.remote-code-session-smoke.v1"
    },
    "status": {
      "const": "ok"
    },
    "checked_at": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "pattern": "^cse_"
    },
    "api_base_url": {
      "type": "string",
      "pattern": "^https?://"
    },
    "sdk_url": {
      "type": "string",
      "pattern": "^https?://"
    },
    "expires_in": {
      "type": "integer",
      "minimum": 1
    },
    "worker_epoch": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
