{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-context-pack.v1.schema.json",
  "title": "Kiana Context Pack v1",
  "type": "object",
  "required": [
    "schema",
    "root",
    "query",
    "terms",
    "limit",
    "max_snippet_lines",
    "files_indexed",
    "skipped_files",
    "snippets",
    "artifact_graph"
  ],
  "properties": {
    "schema": {
      "const": "kiana.context-pack.v1"
    },
    "root": {
      "type": "string",
      "minLength": 1
    },
    "query": {
      "type": "string"
    },
    "terms": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limit": {
      "type": "integer",
      "minimum": 1
    },
    "max_snippet_lines": {
      "type": "integer",
      "minimum": 1
    },
    "files_indexed": {
      "type": "integer",
      "minimum": 0
    },
    "skipped_files": {
      "type": "integer",
      "minimum": 0
    },
    "snippets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "language",
          "content_hash",
          "score",
          "occurrences",
          "matched_terms",
          "start_line",
          "end_line",
          "excerpt"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "type": ["string", "null"]
          },
          "content_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{16}$"
          },
          "score": {
            "type": "integer",
            "minimum": 0
          },
          "occurrences": {
            "type": "integer",
            "minimum": 0
          },
          "matched_terms": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "start_line": {
            "type": "integer",
            "minimum": 0
          },
          "end_line": {
            "type": "integer",
            "minimum": 0
          },
          "excerpt": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "artifact_graph": {
      "type": "object",
      "required": [
        "schema",
        "nodes",
        "edges"
      ],
      "properties": {
        "schema": {
          "const": "kiana.context-artifact-graph.v1"
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind",
              "path",
              "language",
              "content_hash",
              "start_line",
              "end_line"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "snippet"
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "language": {
                "type": ["string", "null"]
              },
              "content_hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{16}$"
              },
              "start_line": {
                "type": "integer",
                "minimum": 0
              },
              "end_line": {
                "type": "integer",
                "minimum": 0
              }
            },
            "additionalProperties": false
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source",
              "target",
              "relation",
              "matched_terms"
            ],
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "relation": {
                "const": "matched"
              },
              "matched_terms": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
