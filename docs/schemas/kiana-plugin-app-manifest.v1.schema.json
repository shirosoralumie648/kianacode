{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-plugin-app-manifest.v1.schema.json",
  "title": "Kiana Plugin App Manifest v1",
  "type": "object",
  "required": ["id", "title", "entry"],
  "properties": {
    "schema": {
      "const": "kiana.plugin-app-manifest.v1"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "entry": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(^|/)\\.\\.?(/|$)).+"
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "title"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^/(?!.*\\\\).*"
          },
          "title": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
