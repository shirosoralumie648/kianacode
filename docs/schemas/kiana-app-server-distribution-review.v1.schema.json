{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-app-server-distribution-review.v1.schema.json",
  "title": "Kiana App Server Distribution Review v1",
  "type": "object",
  "required": [
    "schema",
    "version",
    "dist_dir",
    "summary",
    "artifacts",
    "channels",
    "enterprise_offline_manifest",
    "blockers"
  ],
  "properties": {
    "schema": {
      "const": "kiana.app-server.distribution-review.v1"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "dist_dir": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "object",
      "required": ["artifacts", "platforms", "channels_ready", "blocking"],
      "properties": {
        "artifacts": {
          "type": "integer",
          "minimum": 0
        },
        "platforms": {
          "type": "object",
          "required": ["linux", "macos", "windows"],
          "properties": {
            "linux": { "type": "boolean" },
            "macos": { "type": "boolean" },
            "windows": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "channels_ready": {
          "type": "integer",
          "minimum": 0
        },
        "blocking": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["target", "archive", "path", "sha256_file", "binary_sha256_file"],
        "properties": {
          "target": { "type": "string", "minLength": 1 },
          "archive": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256_file": { "type": ["string", "null"] },
          "binary_sha256_file": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "channels": {
      "type": "object",
      "required": ["github_releases", "homebrew", "winget"],
      "properties": {
        "github_releases": {
          "type": "object",
          "required": ["status", "artifact_count"],
          "properties": {
            "status": { "enum": ["ready", "blocked", "missing"] },
            "artifact_count": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "homebrew": {
          "type": "object",
          "required": ["status", "formulae"],
          "properties": {
            "status": { "enum": ["ready", "blocked", "missing"] },
            "formulae": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "winget": {
          "type": "object",
          "required": ["status", "manifests", "blocked_path"],
          "properties": {
            "status": { "enum": ["ready", "blocked", "missing"] },
            "manifests": { "type": "array", "items": { "type": "string" } },
            "blocked_path": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "enterprise_offline_manifest": {
      "type": "object",
      "required": ["present", "path", "valid"],
      "properties": {
        "present": { "type": "boolean" },
        "path": { "type": "string", "minLength": 1 },
        "valid": { "type": "boolean" },
        "schema": { "type": "string" },
        "artifact_count": { "type": "integer", "minimum": 0 },
        "channels": { "type": ["object", "null"] },
        "error": { "type": "string" }
      },
      "additionalProperties": false
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "blocking", "message"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "blocking": { "type": "boolean" },
          "message": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
