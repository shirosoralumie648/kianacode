{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-context-artifact-ingest.v1.schema.json",
  "title": "Kiana Context Artifact Ingest v1",
  "type": "object",
  "required": [
    "schema",
    "root",
    "source_root",
    "store_dir",
    "manifest_path",
    "artifacts_schema",
    "ingested_files",
    "skipped_files",
    "total_bytes",
    "artifacts"
  ],
  "properties": {
    "schema": {
      "const": "kiana.context-artifact-ingest.v1"
    },
    "root": {
      "type": "string",
      "minLength": 1
    },
    "source_root": {
      "type": "string",
      "minLength": 1
    },
    "store_dir": {
      "type": "string",
      "minLength": 1
    },
    "manifest_path": {
      "type": "string",
      "minLength": 1
    },
    "artifacts_schema": {
      "const": "kiana.context-artifacts.v1"
    },
    "ingested_files": {
      "type": "integer",
      "minimum": 0
    },
    "skipped_files": {
      "type": "integer",
      "minimum": 0
    },
    "total_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "source_path",
          "stored_path",
          "language",
          "bytes",
          "line_count",
          "content_hash"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ingest:.+:[0-9a-f]{16}$"
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "source_path": {
            "type": "string",
            "minLength": 1
          },
          "stored_path": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "type": ["string", "null"]
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "line_count": {
            "type": "integer",
            "minimum": 0
          },
          "content_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{16}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
