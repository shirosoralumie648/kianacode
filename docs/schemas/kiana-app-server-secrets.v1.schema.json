{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-app-server-secrets.v1.schema.json",
  "title": "Kiana App Server Secrets v1",
  "type": "object",
  "required": [
    "schema",
    "metadata_supported",
    "values",
    "summary",
    "read_supported",
    "write_supported",
    "policy"
  ],
  "properties": {
    "schema": {
      "const": "kiana.app-server.secrets.v1"
    },
    "metadata_supported": {
      "const": true
    },
    "values": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "status",
          "source",
          "value",
          "readable",
          "writable"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "set",
              "missing",
              "invalid"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "enum": [
              "redacted",
              "missing",
              "invalid"
            ]
          },
          "readable": {
            "const": false
          },
          "writable": {
            "const": false
          },
          "file": {
            "type": "string"
          },
          "store": {
            "type": "string"
          },
          "refreshable": {
            "type": "boolean"
          },
          "expired": {
            "type": "boolean"
          },
          "expiring": {
            "type": "boolean"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "total",
        "set",
        "missing",
        "invalid"
      ],
      "properties": {
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "set": {
          "type": "integer",
          "minimum": 0
        },
        "missing": {
          "type": "integer",
          "minimum": 0
        },
        "invalid": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "read_supported": {
      "const": false
    },
    "write_supported": {
      "const": false
    },
    "policy": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
