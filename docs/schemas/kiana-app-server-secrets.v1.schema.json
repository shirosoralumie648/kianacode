{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-app-server-secrets.v1.schema.json",
  "title": "Kiana App Server Secrets v1",
  "type": "object",
  "required": [
    "schema",
    "values",
    "read_supported",
    "write_supported",
    "policy"
  ],
  "properties": {
    "schema": {
      "const": "kiana.app-server.secrets.v1"
    },
    "values": {
      "type": "array",
      "maxItems": 0
    },
    "read_supported": {
      "const": false
    },
    "write_supported": {
      "const": false
    },
    "policy": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
