{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-diff.v1.schema.json",
  "title": "Kiana Diff v1",
  "type": "object",
  "required": [
    "schema",
    "root",
    "inside_git_repo",
    "dirty",
    "files",
    "staged",
    "unstaged"
  ],
  "properties": {
    "schema": {
      "const": "kiana.diff.v1"
    },
    "root": {
      "type": "string",
      "minLength": 1
    },
    "inside_git_repo": {
      "type": "boolean"
    },
    "dirty": {
      "type": "boolean"
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diffFile"
      }
    },
    "staged": {
      "$ref": "#/$defs/diffSection"
    },
    "unstaged": {
      "$ref": "#/$defs/diffSection"
    }
  },
  "$defs": {
    "diffFile": {
      "type": "object",
      "required": ["path", "index", "worktree"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "index": {
          "type": "string",
          "minLength": 1
        },
        "worktree": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "diffSection": {
      "type": "object",
      "required": ["changed", "stat"],
      "properties": {
        "changed": {
          "type": "boolean"
        },
        "stat": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
