{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-license-status.v1.schema.json",
  "title": "Kiana License Status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "source",
    "license_key",
    "offline",
    "entitlements",
    "issues"
  ],
  "properties": {
    "schema": {
      "const": "kiana.license-status.v1"
    },
    "status": {
      "type": "string",
      "enum": ["missing", "partial", "configured", "invalid"]
    },
    "source": {
      "type": "string"
    },
    "license_key": {
      "type": "string",
      "enum": ["missing", "set"]
    },
    "license_key_preview": {
      "type": "string"
    },
    "account_id": {
      "type": "string"
    },
    "plan": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "issuer": {
      "type": "string"
    },
    "expires_at": {
      "type": "string"
    },
    "offline": {
      "type": "boolean"
    },
    "entitlements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "managed_policy_file": {
      "type": "string"
    },
    "support_contact": {
      "type": "string"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
