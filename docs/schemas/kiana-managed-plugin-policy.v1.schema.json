{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-managed-plugin-policy.v1.schema.json",
  "title": "Kiana Managed Plugin Policy v1",
  "type": "object",
  "required": ["schema", "plugins"],
  "properties": {
    "schema": {
      "const": "kiana.managed-plugin-policy.v1"
    },
    "plugins": {
      "type": "object",
      "properties": {
        "allow": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "deny": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowMarketplaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "denyMarketplaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "denyPathInstalls": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
