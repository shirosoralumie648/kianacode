{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-workflow-transition.v1.schema.json",
  "title": "Kiana Workflow Transition Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "workflow_id",
    "transition_id",
    "from",
    "to",
    "decision",
    "evidence",
    "first_event_seq",
    "last_event_seq",
    "current_node",
    "status",
    "idempotent"
  ],
  "properties": {
    "schema": { "const": "kiana.workflow-transition.v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "workflow_id": { "type": "string", "minLength": 1 },
    "transition_id": { "type": "string", "pattern": "^tr_[A-Za-z0-9_-]+$" },
    "from": { "type": "string", "minLength": 1 },
    "to": { "type": "string", "minLength": 1 },
    "decision": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "bytes": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "first_event_seq": { "type": "integer", "minimum": 1 },
    "last_event_seq": { "type": "integer", "minimum": 1 },
    "current_node": { "type": "string", "minLength": 1 },
    "status": { "const": "running" },
    "idempotent": { "type": "boolean" }
  }
}
