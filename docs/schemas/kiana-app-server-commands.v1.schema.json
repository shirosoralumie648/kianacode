{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-app-server-commands.v1.schema.json",
  "title": "Kiana App Server Commands v1",
  "type": "object",
  "required": ["schema", "workspace", "count", "commands"],
  "properties": {
    "schema": {
      "const": "kiana.app-server.commands.v1"
    },
    "workspace": {
      "type": "string",
      "minLength": 1
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "slash",
          "description",
          "command_type",
          "enabled",
          "supports_non_interactive",
          "routes_to",
          "source"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "slash": {
            "type": "string",
            "pattern": "^/.+"
          },
          "description": {
            "type": "string"
          },
          "command_type": {
            "enum": ["local", "local_jsx", "prompt"]
          },
          "enabled": {
            "type": "boolean"
          },
          "supports_non_interactive": {
            "type": "boolean"
          },
          "routes_to": {
            "enum": ["local_command", "assistant_prompt"]
          },
          "source": {
            "type": "object",
            "required": ["kind", "plugin"],
            "properties": {
              "kind": {
                "enum": ["core", "plugin"]
              },
              "plugin": {
                "type": ["string", "null"]
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
