{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-license-compliance-summary.v1.schema.json",
  "title": "Kiana License Compliance Summary v1",
  "description": "Per-package dependency license table generated from cargo metadata.",
  "type": "object",
  "required": ["schema", "generated_at", "total_packages", "workspace_packages", "third_party_packages", "unknown_license_count", "packages"],
  "properties": {
    "schema":                { "const": "kiana.license-compliance-summary.v1" },
    "generated_at":          { "type": "string", "minLength": 1 },
    "total_packages":        { "type": "integer", "minimum": 0 },
    "workspace_packages":    { "type": "integer", "minimum": 0 },
    "third_party_packages":  { "type": "integer", "minimum": 0 },
    "unknown_license_count": { "type": "integer", "minimum": 0 },
    "packages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "version", "license", "source", "repository"],
        "properties": {
          "name":       { "type": "string", "minLength": 1 },
          "version":    { "type": "string", "minLength": 1 },
          "license":    { "type": "string" },
          "source":     { "type": "string", "enum": ["workspace", "registry"] },
          "repository": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
