{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-memory-record.v1.schema.json",
  "title": "Kiana Memory Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "kind",
    "source",
    "text",
    "redaction_count",
    "created_at_ms"
  ],
  "properties": {
    "schema": { "const": "kiana.memory-record.v1" },
    "id": { "type": "string", "pattern": "^mem-[0-9]+-[0-9a-f]{16}$" },
    "kind": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
    "source": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
    "text": { "type": "string", "minLength": 1 },
    "redaction_count": { "type": "integer", "minimum": 0 },
    "created_at_ms": { "type": "integer", "minimum": 0 }
  }
}
