{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-runtime-event.v1.schema.json",
  "title": "Kiana Runtime Event v1",
  "type": "object",
  "required": [
    "event_id",
    "session_id",
    "turn_id",
    "sequence",
    "timestamp",
    "type"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "turn_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_turn_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "timestamp": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "user_message",
        "assistant_message",
        "stream_delta",
        "tool_call",
        "tool_result",
        "permission_request",
        "session_event",
        "error",
        "result"
      ]
    },
    "message": {},
    "delta": {},
    "tool_call_id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string"
    },
    "workbench": {
      "type": "string"
    },
    "input": {},
    "is_error": {
      "type": "boolean"
    },
    "content": {},
    "changed_files": {},
    "error": {},
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "tool_name": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string"
    },
    "subtype": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {},
    "code": {
      "type": "string"
    },
    "details": {},
    "status": {
      "type": "string",
      "minLength": 1
    },
    "stop_reason": {
      "type": "string",
      "minLength": 1
    },
    "assistant_text": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "user_message"
          }
        }
      },
      "then": {
        "required": ["message"]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "assistant_message"
          }
        }
      },
      "then": {
        "required": ["message"]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "stream_delta"
          }
        }
      },
      "then": {
        "required": ["delta"]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "tool_call"
          }
        }
      },
      "then": {
        "required": ["tool_call_id", "name", "input"]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "tool_result"
          }
        }
      },
      "then": {
        "required": ["tool_call_id", "is_error", "content"]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "permission_request"
          }
        }
      },
      "then": {
        "required": ["request_id", "tool_name", "action", "input"]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "session_event"
          }
        }
      },
      "then": {
        "required": ["subtype", "metadata"]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "error"
          }
        }
      },
      "then": {
        "required": ["message", "details"]
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "result"
          }
        }
      },
      "then": {
        "required": ["status", "stop_reason", "metadata"]
      }
    }
  ]
}
