{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-public-parity-baseline.v1.schema.json",
  "title": "Kiana Public Parity Baseline v1",
  "description": "Immutable public-parity revision. Structural validity does not prove journey completion or exhaustive official-source coverage.",
  "type": "object",
  "required": [
    "schema",
    "version",
    "revision_id",
    "revision_kind",
    "snapshot_id",
    "frozen_at",
    "applicable_product_version",
    "source_artifact",
    "official_source_index",
    "journeys",
    "capabilities"
  ],
  "properties": {
    "schema": {
      "const": "kiana.public-parity-baseline.v1"
    },
    "version": {
      "const": "1.0"
    },
    "revision_id": {
      "$ref": "#/$defs/stableId"
    },
    "revision_kind": {
      "type": "string",
      "enum": ["genesis", "successor"]
    },
    "genesis_reason": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "previous_revision_id": {
      "$ref": "#/$defs/stableId"
    },
    "previous_revision_path": {
      "$ref": "#/$defs/repositoryRelativePath"
    },
    "previous_revision_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "snapshot_id": {
      "$ref": "#/$defs/stableId"
    },
    "frozen_at": {
      "$ref": "#/$defs/timestamp"
    },
    "applicable_product_version": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "source_artifact": {
      "$ref": "#/$defs/sourceArtifactBinding"
    },
    "official_source_index": {
      "description": "Exhaustive source-entry mappings are checked semantically with stable errors missing_required_capability, unmapped_source_entry, duplicate_source_mapping, and unjustified_exclusion.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourceMapping"
      }
    },
    "journeys": {
      "description": "Exactly fifteen governed journey rows are required; ID uniqueness and required/optional cross-reference membership are semantic validation responsibilities.",
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "$ref": "#/$defs/journey"
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/capability"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["revision_kind"],
        "properties": {
          "revision_kind": {
            "const": "genesis"
          }
        }
      },
      "then": {
        "required": ["genesis_reason"],
        "allOf": [
          {
            "not": {
              "required": ["previous_revision_id"]
            }
          },
          {
            "not": {
              "required": ["previous_revision_path"]
            }
          },
          {
            "not": {
              "required": ["previous_revision_sha256"]
            }
          }
        ]
      }
    },
    {
      "if": {
        "required": ["revision_kind"],
        "properties": {
          "revision_kind": {
            "const": "successor"
          }
        }
      },
      "then": {
        "required": [
          "previous_revision_id",
          "previous_revision_path",
          "previous_revision_sha256"
        ],
        "not": {
          "required": ["genesis_reason"]
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "repositoryRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/].*$"
    },
    "stringIdArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/stableId"
      }
    },
    "sourceArtifactBinding": {
      "type": "object",
      "required": ["artifact_id", "path", "sha256", "content_sha256"],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/stableId"
        },
        "path": {
          "$ref": "#/$defs/repositoryRelativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "sourceMapping": {
      "type": "object",
      "required": ["source_entry_id"],
      "properties": {
        "source_entry_id": {
          "$ref": "#/$defs/stableId"
        },
        "capability_ids": {
          "allOf": [
            {
              "$ref": "#/$defs/stringIdArray"
            },
            {
              "minItems": 1
            }
          ]
        },
        "exclusion": {
          "$ref": "#/$defs/sourceExclusion"
        }
      },
      "oneOf": [
        {
          "required": ["capability_ids"],
          "not": {
            "required": ["exclusion"]
          }
        },
        {
          "required": ["exclusion"],
          "not": {
            "required": ["capability_ids"]
          }
        }
      ],
      "additionalProperties": false
    },
    "sourceExclusion": {
      "type": "object",
      "required": [
        "classification",
        "rationale",
        "evidence_ids",
        "review_revision"
      ],
      "properties": {
        "classification": {
          "type": "string",
          "enum": [
            "not_public_contract",
            "duplicate_navigation",
            "non_capability_metadata",
            "out_of_scope_product"
          ]
        },
        "rationale": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evidence_ids": {
          "allOf": [
            {
              "$ref": "#/$defs/stringIdArray"
            },
            {
              "minItems": 1
            }
          ]
        },
        "review_revision": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "journey": {
      "type": "object",
      "required": [
        "journey_id",
        "title",
        "required_capability_ids",
        "optional_capability_ids"
      ],
      "properties": {
        "journey_id": {
          "$ref": "#/$defs/stableId"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "required_capability_ids": {
          "allOf": [
            {
              "$ref": "#/$defs/stringIdArray"
            },
            {
              "minItems": 1
            }
          ]
        },
        "optional_capability_ids": {
          "$ref": "#/$defs/stringIdArray"
        }
      },
      "additionalProperties": false
    },
    "capability": {
      "type": "object",
      "required": [
        "capability_id",
        "title",
        "parity_outcome",
        "coverage_state",
        "required_proof_level",
        "proof_level",
        "freshness",
        "owner",
        "target_phase",
        "evidence_ids",
        "gap",
        "difference"
      ],
      "properties": {
        "capability_id": {
          "$ref": "#/$defs/stableId"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "parity_outcome": {
          "type": "string",
          "enum": [
            "match",
            "adapted",
            "intentional_difference",
            "unsupported",
            "not_applicable",
            "unassessed"
          ]
        },
        "coverage_state": {
          "type": "string",
          "enum": [
            "unassessed",
            "missing",
            "partial",
            "implemented",
            "verified",
            "blocked",
            "intentional_difference",
            "not_applicable"
          ]
        },
        "required_proof_level": {
          "$ref": "#/$defs/proofLevel"
        },
        "proof_level": {
          "$ref": "#/$defs/proofLevel"
        },
        "freshness": {
          "$ref": "#/$defs/freshness"
        },
        "owner": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "target_phase": {
          "type": "string",
          "pattern": "^[0-9]{2}(?:[.][0-9]+)?$"
        },
        "evidence_ids": {
          "allOf": [
            {
              "$ref": "#/$defs/stringIdArray"
            },
            {
              "minItems": 1
            }
          ]
        },
        "gap": {
          "$ref": "#/$defs/gap"
        },
        "difference": {
          "$ref": "#/$defs/difference"
        }
      },
      "additionalProperties": false
    },
    "proofLevel": {
      "type": "string",
      "enum": [
        "none",
        "source",
        "local_contract",
        "local_behavior",
        "target_environment",
        "user_value"
      ]
    },
    "freshness": {
      "type": "string",
      "enum": ["current", "stale", "superseded"]
    },
    "gap": {
      "type": "object",
      "required": ["status", "reason"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["none", "open", "blocked"]
        },
        "reason": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "difference": {
      "type": "object",
      "required": ["classification", "rationale"],
      "properties": {
        "classification": {
          "type": "string",
          "enum": ["none", "intentional", "unsupported", "not_applicable"]
        },
        "rationale": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
