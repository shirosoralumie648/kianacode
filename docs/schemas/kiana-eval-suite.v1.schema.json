{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-eval-suite.v1.schema.json",
  "title": "Kiana Eval Suite v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "cases"],
  "properties": {
    "schema": { "const": "kiana.eval-suite.v1" },
    "id": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "fixture", "expect"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "const": "runtime_event_replay" },
        "fixture": { "type": "string", "minLength": 1 },
        "expect": { "$ref": "#/$defs/expect" }
      }
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "final_status": { "type": "string", "minLength": 1 },
        "stop_reason": { "type": "string", "minLength": 1 },
        "min_event_count": { "type": "integer", "minimum": 0 },
        "tool_call_count": { "type": "integer", "minimum": 0 },
        "tool_error_count": { "type": "integer", "minimum": 0 },
        "required_tool_names": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "final_text_contains": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "max_input_tokens": { "type": "integer", "minimum": 0 },
        "max_output_tokens": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
