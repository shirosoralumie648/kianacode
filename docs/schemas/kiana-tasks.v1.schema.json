{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-tasks.v1.schema.json",
  "title": "Kiana Tasks v1",
  "type": "object",
  "required": [
    "schema",
    "task_list_id",
    "tasks_dir",
    "count",
    "status_counts",
    "tasks"
  ],
  "properties": {
    "schema": {
      "const": "kiana.tasks.v1"
    },
    "task_list_id": {
      "type": "string",
      "minLength": 1
    },
    "tasks_dir": {
      "type": "string",
      "minLength": 1
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "status_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "taskId": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": ["string", "null"]
          },
          "subject": {
            "type": ["string", "null"]
          },
          "description": {},
          "status": {
            "type": "string",
            "minLength": 1
          },
          "owner": {},
          "blocks": {
            "type": "array"
          },
          "blockedBy": {
            "type": "array"
          },
          "blocked_by": {
            "type": "array"
          },
          "created_at": {},
          "updated_at": {}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
