{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-workflow-release-binding.v1.schema.json",
  "title": "Kiana Workflow Release Binding v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "workflow_id", "workflow", "git"],
  "properties": {
    "schema": { "const": "kiana.workflow-release-binding.v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "workflow_id": { "type": "string", "minLength": 1 },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "current_node",
        "last_event_seq",
        "last_event_kind",
        "state_sha256",
        "eventlog_sha256"
      ],
      "properties": {
        "status": {
          "enum": ["initialized", "running", "blocked", "completed", "cancelled"]
        },
        "current_node": { "type": "string", "minLength": 1 },
        "last_event_seq": { "type": "integer", "minimum": 1 },
        "last_event_kind": { "type": "string", "minLength": 1 },
        "state_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "eventlog_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "head",
        "index_diff_sha256",
        "worktree_diff_sha256",
        "status_sha256"
      ],
      "properties": {
        "repository": { "const": true },
        "head": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "index_diff_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "worktree_diff_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "status_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
