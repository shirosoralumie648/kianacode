{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-app-server-permissions-status.v1.schema.json",
  "title": "Kiana App Server Permissions Status v1",
  "type": "object",
  "required": [
    "schema",
    "workspace",
    "profile",
    "mode",
    "sources",
    "file",
    "managed_policy",
    "rules",
    "interactive_prompts"
  ],
  "properties": {
    "schema": {
      "const": "kiana.app-server.permissions-status.v1"
    },
    "workspace": {
      "type": "string",
      "minLength": 1
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": false
    },
    "file": {
      "type": "object",
      "required": ["path", "status", "loaded", "error"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": ["loaded", "missing", "error"]
        },
        "loaded": {
          "type": "boolean"
        },
        "error": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "managed_policy": {
      "type": "object",
      "required": ["path", "status", "loaded", "error"],
      "properties": {
        "path": {
          "type": ["string", "null"]
        },
        "status": {
          "type": "string",
          "enum": ["loaded", "missing", "error", "none"]
        },
        "loaded": {
          "type": "boolean"
        },
        "error": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "rules": {
      "type": "object",
      "required": [
        "allowed_tools",
        "disallowed_tools",
        "ask_tools",
        "managed_allowed_tools",
        "managed_disallowed_tools",
        "managed_ask_tools"
      ],
      "properties": {
        "allowed_tools": {
          "$ref": "#/$defs/toolRuleList"
        },
        "disallowed_tools": {
          "$ref": "#/$defs/toolRuleList"
        },
        "ask_tools": {
          "$ref": "#/$defs/toolRuleList"
        },
        "managed_allowed_tools": {
          "$ref": "#/$defs/toolRuleList"
        },
        "managed_disallowed_tools": {
          "$ref": "#/$defs/toolRuleList"
        },
        "managed_ask_tools": {
          "$ref": "#/$defs/toolRuleList"
        }
      },
      "additionalProperties": false
    },
    "interactive_prompts": {
      "type": "object",
      "required": ["supported", "non_interactive_requires_allow_rule"],
      "properties": {
        "supported": {
          "type": "boolean"
        },
        "non_interactive_requires_allow_rule": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "toolRuleList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
