{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-app-server-trust-status.v1.schema.json",
  "title": "Kiana App Server Trust Status v1",
  "type": "object",
  "required": [
    "schema",
    "workspace",
    "project_trust",
    "project_trusted",
    "allows_project_resources",
    "source",
    "project_id",
    "project_root",
    "file",
    "legacy_project_file"
  ],
  "properties": {
    "schema": {
      "const": "kiana.app-server.trust-status.v1"
    },
    "workspace": {
      "type": "string",
      "minLength": 1
    },
    "project_trust": {
      "type": "string",
      "enum": ["unknown", "trusted", "untrusted"]
    },
    "project_trusted": {
      "type": "boolean"
    },
    "allows_project_resources": {
      "type": "boolean"
    },
    "source": {
      "type": "string",
      "enum": ["session", "user_store", "default"]
    },
    "project_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "project_root": {
      "type": "string",
      "minLength": 1
    },
    "file": {
      "type": "object",
      "required": ["path", "status", "exists", "error"],
      "properties": {
        "path": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": "string",
          "enum": ["found", "missing", "error"]
        },
        "exists": {
          "type": "boolean"
        },
        "error": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "legacy_project_file": {
      "type": "object",
      "required": ["path", "exists", "ignored", "reason"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "exists": {
          "type": "boolean"
        },
        "ignored": {
          "const": true
        },
        "reason": {
          "const": "project_local_trust_is_not_authoritative"
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "project_trust": {
            "const": "trusted"
          }
        },
        "required": ["project_trust"]
      },
      "then": {
        "properties": {
          "project_trusted": {
            "const": true
          },
          "allows_project_resources": {
            "const": true
          }
        }
      },
      "else": {
        "properties": {
          "project_trusted": {
            "const": false
          },
          "allows_project_resources": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "const": "default"
          }
        },
        "required": ["source"]
      },
      "then": {
        "properties": {
          "project_trust": {
            "const": "unknown"
          },
          "file": {
            "properties": {
              "status": {
                "enum": ["missing", "error"]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "const": "user_store"
          }
        },
        "required": ["source"]
      },
      "then": {
        "properties": {
          "project_trust": {
            "enum": ["trusted", "untrusted"]
          },
          "file": {
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "const": "found"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "const": "session"
          }
        },
        "required": ["source"]
      },
      "then": {
        "properties": {
          "project_trust": {
            "enum": ["trusted", "untrusted"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "file": {
            "properties": {
              "status": {
                "const": "found"
              }
            },
            "required": ["status"]
          }
        },
        "required": ["file"]
      },
      "then": {
        "properties": {
          "file": {
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "exists": {
                "const": true
              },
              "error": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "file": {
            "properties": {
              "status": {
                "const": "missing"
              }
            },
            "required": ["status"]
          }
        },
        "required": ["file"]
      },
      "then": {
        "properties": {
          "file": {
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "exists": {
                "const": false
              },
              "error": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "file": {
            "properties": {
              "status": {
                "const": "error"
              }
            },
            "required": ["status"]
          }
        },
        "required": ["file"]
      },
      "then": {
        "properties": {
          "file": {
            "properties": {
              "error": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "file": {
            "properties": {
              "path": {
                "type": "null"
              }
            },
            "required": ["path"]
          }
        },
        "required": ["file"]
      },
      "then": {
        "properties": {
          "file": {
            "properties": {
              "status": {
                "const": "error"
              },
              "exists": {
                "const": false
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
