{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-eda-review.v1.schema.json",
  "title": "Kiana EDA Review Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "rule_version",
    "workflow_id",
    "run_id",
    "review_id",
    "created_at_ms",
    "status",
    "sources",
    "checks",
    "findings",
    "summary",
    "limitations",
    "approval_requirements",
    "next_action",
    "artifacts"
  ],
  "properties": {
    "schema": {
      "const": "kiana.eda-review.v1"
    },
    "rule_version": {
      "type": "string",
      "enum": ["eda-review-rules.v1", "eda-review-rules.v2"]
    },
    "workflow_id": {
      "type": "string",
      "pattern": "^wf-[a-z0-9]+$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run-[0-9]+-[a-z0-9]+$"
    },
    "review_id": {
      "type": "string",
      "pattern": "^eda-[a-f0-9]{20}$"
    },
    "created_at_ms": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "type": "string",
      "enum": ["pass", "review_required", "blocked"]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "size", "sha256", "media_type"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["requirements", "schematic", "bom", "gerber", "cpl", "constraints", "netlist"]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": { "const": "netlist" }
              },
              "required": ["kind"]
            },
            "then": {
              "properties": {
                "media_type": { "const": "application/xml" }
              }
            }
          }
        ]
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check_id", "status", "summary", "evidence"],
        "properties": {
          "check_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": ["pass", "fail", "blocked", "partial", "evaluated", "review", "not_supplied"]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "message", "evidence", "recommendation"],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": ["blocked", "error", "warning", "info"]
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "recommendation": {
            "type": "string",
            "minLength": 1
          },
          "designator": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocked", "errors", "warnings", "info", "bom_rows", "cpl_rows", "gerber_files"],
      "properties": {
        "blocked": { "type": "integer", "minimum": 0 },
        "errors": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "info": { "type": "integer", "minimum": 0 },
        "bom_rows": { "type": "integer", "minimum": 0 },
        "cpl_rows": { "type": "integer", "minimum": 0 },
        "gerber_files": { "type": "integer", "minimum": 0 },
        "netlist_components": { "type": "integer", "minimum": 0 },
        "net_count": { "type": "integer", "minimum": 0 },
        "power_net_count": { "type": "integer", "minimum": 0 },
        "interface_net_count": { "type": "integer", "minimum": 0 },
        "dangling_net_count": { "type": "integer", "minimum": 0 }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "approval_requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "hardware_order",
          "cost_incurred",
          "production_file_mutation",
          "automatic_component_replacement"
        ]
      }
    },
    "next_action": {
      "type": "string",
      "enum": ["engineer_review_then_bringup", "resolve_findings_and_rerun", "supply_required_artifacts"]
    },
    "artifacts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^eda/reviews/eda-[a-f0-9]{20}/(eda_review\\.json|bom_risk\\.md|bringup-plan\\.md)$"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": { "const": "pass" }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "summary": {
            "properties": {
              "blocked": { "const": 0 },
              "errors": { "const": 0 }
            },
            "required": ["blocked", "errors"]
          },
          "sources": {
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "kind": { "const": "schematic" }
                  },
                  "required": ["kind"]
                },
                "minContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "kind": { "const": "bom" }
                  },
                  "required": ["kind"]
                },
                "minContains": 1
              },
              {
                "contains": {
                  "properties": {
                    "kind": { "const": "gerber" }
                  },
                  "required": ["kind"]
                },
                "minContains": 1
              }
            ]
          },
          "findings": {
            "not": {
              "contains": {
                "properties": {
                  "severity": { "enum": ["blocked", "error"] }
                },
                "required": ["severity"]
              }
            }
          }
        },
        "required": ["summary", "sources", "findings"]
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "blocked" }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "summary": {
            "properties": {
              "blocked": { "minimum": 1 }
            },
            "required": ["blocked"]
          }
        },
        "required": ["summary"]
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "review_required" }
        },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "summary": {
            "properties": {
              "errors": { "minimum": 1 }
            },
            "required": ["errors"]
          }
        },
        "required": ["summary"]
      }
    },
    {
      "if": {
        "properties": {
          "rule_version": { "const": "eda-review-rules.v2" }
        },
        "required": ["rule_version"]
      },
      "then": {
        "properties": {
          "summary": {
            "required": [
              "netlist_components",
              "net_count",
              "power_net_count",
              "interface_net_count",
              "dangling_net_count"
            ]
          }
        },
        "required": ["summary"]
      }
    },
    {
      "if": {
        "properties": {
          "sources": {
            "contains": {
              "properties": {
                "kind": { "const": "netlist" }
              },
              "required": ["kind"]
            },
            "minContains": 1
          }
        },
        "required": ["sources"]
      },
      "then": {
        "properties": {
          "checks": {
            "contains": {
              "properties": {
                "check_id": { "const": "netlist_structure" }
              },
              "required": ["check_id"]
            },
            "minContains": 1
          }
        },
        "required": ["checks"]
      }
    }
  ]
}
