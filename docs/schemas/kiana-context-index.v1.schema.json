{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-context-index.v1.schema.json",
  "title": "Kiana Context Index v1",
  "type": "object",
  "required": [
    "schema",
    "root",
    "files_indexed",
    "skipped_files",
    "total_bytes",
    "files"
  ],
  "properties": {
    "schema": {
      "const": "kiana.context-index.v1"
    },
    "root": {
      "type": "string",
      "minLength": 1
    },
    "files_indexed": {
      "type": "integer",
      "minimum": 0
    },
    "skipped_files": {
      "type": "integer",
      "minimum": 0
    },
    "total_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "language", "bytes", "line_count", "content_hash"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "type": ["string", "null"]
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "line_count": {
            "type": "integer",
            "minimum": 0
          },
          "content_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{16}$"
          }
        },
        "additionalProperties": false
      }
    },
    "cache": {
      "type": "object",
      "required": [
        "path",
        "status",
        "reused_files",
        "added_files",
        "changed_files",
        "removed_files"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": ["created", "updated", "recovered"]
        },
        "reused_files": {
          "type": "integer",
          "minimum": 0
        },
        "added_files": {
          "type": "integer",
          "minimum": 0
        },
        "changed_files": {
          "type": "integer",
          "minimum": 0
        },
        "removed_files": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
