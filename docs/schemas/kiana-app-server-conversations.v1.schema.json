{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-app-server-conversations.v1.schema.json",
  "title": "Kiana App Server Conversations v1",
  "type": "object",
  "required": ["schema", "count", "conversations"],
  "properties": {
    "schema": {
      "const": "kiana.app-server.conversations.v1"
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "conversations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "session_id",
          "source",
          "active",
          "events_url",
          "events_snapshot_url"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "session_id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "enum": ["direct-connect", "sdk-session-store"]
          },
          "active": {
            "type": "boolean"
          },
          "title": {
            "type": ["string", "null"]
          },
          "tag": {
            "type": ["string", "null"]
          },
          "parent_session_id": {
            "type": ["string", "null"]
          },
          "work_dir": {
            "type": ["string", "null"]
          },
          "dangerously_skip_permissions": {
            "type": "boolean"
          },
          "created_at": {
            "type": "integer",
            "minimum": 0
          },
          "updated_at": {
            "type": "integer",
            "minimum": 0
          },
          "message_count": {
            "type": "integer",
            "minimum": 0
          },
          "assistant_message_count": {
            "type": "integer",
            "minimum": 0
          },
          "last_role": {
            "type": ["string", "null"]
          },
          "events_url": {
            "type": ["string", "null"],
            "pattern": "^/sessions/.+/ws$"
          },
          "events_snapshot_url": {
            "type": "string",
            "pattern": "^/app/conversations/.+/events$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
