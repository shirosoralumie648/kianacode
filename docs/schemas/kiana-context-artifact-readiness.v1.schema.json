{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-context-artifact-readiness.v1.schema.json",
  "title": "Kiana Context Artifact Readiness v1",
  "type": "object",
  "required": [
    "schema",
    "root",
    "artifact_store_schema",
    "status",
    "artifact_count",
    "dependency_count",
    "required_roles",
    "missing_roles"
  ],
  "properties": {
    "schema": {
      "const": "kiana.context-artifact-readiness.v1"
    },
    "root": {
      "type": "string",
      "minLength": 1
    },
    "artifact_store_schema": {
      "const": "kiana.context-artifact-store.v1"
    },
    "status": {
      "enum": ["ready", "incomplete"]
    },
    "artifact_count": {
      "type": "integer",
      "minimum": 0
    },
    "dependency_count": {
      "type": "integer",
      "minimum": 0
    },
    "required_roles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["role", "required", "present", "count"],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "present": {
            "type": "boolean"
          },
          "count": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      }
    },
    "missing_roles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
