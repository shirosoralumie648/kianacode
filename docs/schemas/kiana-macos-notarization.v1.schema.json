{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-macos-notarization.v1.schema.json",
  "title": "Kiana macOS Notarization v1",
  "type": "object",
  "required": [
    "schema",
    "status",
    "target",
    "archive",
    "accepted_at",
    "authority",
    "notarization_id"
  ],
  "properties": {
    "schema": {
      "const": "kiana.macos-notarization.v1"
    },
    "status": {
      "const": "accepted"
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "archive": {
      "type": "string",
      "minLength": 1
    },
    "accepted_at": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "type": "string",
      "minLength": 1
    },
    "notarization_id": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
