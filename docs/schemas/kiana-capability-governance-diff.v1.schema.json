{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-capability-governance-diff.v1.schema.json",
  "title": "Kiana Capability Governance Diff v1",
  "description": "Deterministic derived metadata between two immutable revisions. Identifier arrays are unique and must be emitted in lexicographic order.",
  "type": "object",
  "required": [
    "schema",
    "version",
    "family",
    "from_revision_id",
    "from_revision_sha256",
    "to_revision_id",
    "to_revision_sha256",
    "added_ids",
    "removed_ids",
    "changed_ids"
  ],
  "properties": {
    "schema": {
      "const": "kiana.capability-governance-diff.v1"
    },
    "version": {
      "const": "1.0"
    },
    "family": {
      "type": "string",
      "enum": [
        "public-baseline",
        "repository-registry"
      ]
    },
    "from_revision_id": {
      "$ref": "#/$defs/stableId"
    },
    "from_revision_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "to_revision_id": {
      "$ref": "#/$defs/stableId"
    },
    "to_revision_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "added_ids": {
      "$ref": "#/$defs/sortedIdArray"
    },
    "removed_ids": {
      "$ref": "#/$defs/sortedIdArray"
    },
    "changed_ids": {
      "$ref": "#/$defs/sortedIdArray"
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sortedIdArray": {
      "description": "Unique stable IDs serialized in ascending lexicographic order; ordering is checked semantically.",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/stableId"
      }
    }
  },
  "additionalProperties": false
}
