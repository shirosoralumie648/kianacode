{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-workflow-completion.v1.schema.json",
  "title": "Kiana Workflow Completion Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "run_id",
    "workflow_id",
    "verification_id",
    "verification_sha256",
    "event_seq",
    "current_node",
    "status",
    "idempotent"
  ],
  "properties": {
    "schema": { "const": "kiana.workflow-completion.v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "workflow_id": { "type": "string", "minLength": 1 },
    "verification_id": { "type": "string", "minLength": 1 },
    "verification_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "event_seq": { "type": "integer", "minimum": 1 },
    "current_node": { "const": "completed" },
    "status": { "const": "completed" },
    "idempotent": { "type": "boolean" }
  }
}
