{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-app-server-config-resolved.v1.schema.json",
  "title": "Kiana App Server Resolved Config v1",
  "type": "object",
  "required": ["schema", "workspace", "config"],
  "properties": {
    "schema": {
      "const": "kiana.app-server.config-resolved.v1"
    },
    "workspace": {
      "type": "string",
      "minLength": 1
    },
    "config": {
      "type": "object",
      "required": ["schema", "config_file", "sources", "values"],
      "properties": {
        "schema": {
          "const": "kiana.config-resolved.v1"
        },
        "config_file": {
          "type": "object"
        },
        "sources": {
          "type": "object"
        },
        "values": {
          "type": "object",
          "required": ["api_key", "base_url", "model", "settings", "sandbox"],
          "properties": {
            "api_key": {
              "type": "object"
            },
            "base_url": {
              "type": "object"
            },
            "model": {
              "type": "object"
            },
            "settings": {
              "type": "object"
            },
            "sandbox": {
              "type": "object"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
