{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-swarm-worker-health.v1.schema.json",
  "title": "Kiana Bounded Swarm Worker Health v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "state",
    "reason",
    "next_action",
    "process",
    "attempt",
    "budget",
    "scope"
  ],
  "properties": {
    "schema": { "const": "kiana.swarm-worker-health.v1" },
    "state": {
      "type": "string",
      "enum": ["pending", "healthy", "retrying", "completed", "attention_required"]
    },
    "reason": { "type": ["string", "null"] },
    "next_action": {
      "type": "string",
      "enum": ["run_swarm_monitor", "swarm_integration_review", "inspect_worker_result"]
    },
    "process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pid", "identity_status", "identity_reason"],
      "properties": {
        "pid": { "type": ["integer", "null"], "minimum": 1 },
        "identity_status": {
          "type": "string",
          "enum": ["verified", "exited", "missing", "mismatch", "unavailable"]
        },
        "identity_reason": { "type": ["string", "null"] }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current", "max", "remaining", "retrying"],
      "properties": {
        "current": { "type": "integer", "minimum": 1 },
        "max": { "type": "integer", "minimum": 1 },
        "remaining": { "type": "integer", "minimum": 0 },
        "retrying": { "type": "boolean" }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_bytes",
        "max_output_bytes",
        "output_bytes_remaining",
        "commands_run",
        "max_commands",
        "commands_remaining",
        "elapsed_ms",
        "timeout_ms",
        "timeout_ms_remaining"
      ],
      "properties": {
        "output_bytes": { "type": "integer", "minimum": 0 },
        "max_output_bytes": { "type": "integer", "minimum": 0 },
        "output_bytes_remaining": { "type": "integer", "minimum": 0 },
        "commands_run": { "type": "integer", "minimum": 0 },
        "max_commands": { "type": "integer", "minimum": 0 },
        "commands_remaining": { "type": "integer", "minimum": 0 },
        "elapsed_ms": { "type": "integer", "minimum": 0 },
        "timeout_ms": { "type": "integer", "minimum": 0 },
        "timeout_ms_remaining": { "type": "integer", "minimum": 0 }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changed_files", "scope_deviations", "project_violation_reason"],
      "properties": {
        "changed_files": { "type": "integer", "minimum": 0 },
        "scope_deviations": { "type": "integer", "minimum": 0 },
        "project_violation_reason": { "type": ["string", "null"] }
      }
    }
  }
}
