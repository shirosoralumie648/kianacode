{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-app-server-command-run.v1.schema.json",
  "title": "Kiana App Server Command Run v1",
  "type": "object",
  "required": [
    "schema",
    "workspace",
    "command",
    "request",
    "status",
    "executed",
    "output"
  ],
  "properties": {
    "schema": {
      "const": "kiana.app-server.command-run.v1"
    },
    "workspace": {
      "type": "string",
      "minLength": 1
    },
    "command": {
      "type": "object",
      "required": [
        "name",
        "slash",
        "description",
        "command_type",
        "enabled",
        "supports_non_interactive",
        "routes_to",
        "source"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "slash": {
          "type": "string",
          "pattern": "^/.+"
        },
        "description": {
          "type": "string"
        },
        "command_type": {
          "enum": ["local", "local_jsx", "prompt"]
        },
        "enabled": {
          "type": "boolean"
        },
        "supports_non_interactive": {
          "type": "boolean"
        },
        "routes_to": {
          "enum": ["local_command", "assistant_prompt"]
        },
        "source": {
          "type": "object",
          "required": ["kind", "plugin"],
          "properties": {
            "kind": {
              "enum": ["core", "plugin"]
            },
            "plugin": {
              "type": ["string", "null"]
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "required": ["args", "arg_count"],
      "properties": {
        "args": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "maxLength": 2048
          }
        },
        "arg_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        }
      },
      "additionalProperties": false
    },
    "status": {
      "const": "ok"
    },
    "executed": {
      "type": "boolean"
    },
    "output": {
      "type": "object",
      "required": ["output_type", "value", "metadata"],
      "properties": {
        "output_type": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string"
        },
        "metadata": {
          "type": ["object", "null"],
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
