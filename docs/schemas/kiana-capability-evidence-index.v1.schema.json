{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-capability-evidence-index.v1.schema.json",
  "title": "Kiana Capability Evidence Index v1",
  "description": "Immutable, hash-chained evidence revisions. Coverage, proof, and freshness remain separate axes, and historical failures or invalidations are never removed.",
  "type": "object",
  "required": [
    "schema",
    "version",
    "revision_id",
    "revision_kind",
    "created_at",
    "records"
  ],
  "properties": {
    "schema": {
      "const": "kiana.capability-evidence-index.v1"
    },
    "version": {
      "const": "1.0"
    },
    "revision_id": {
      "$ref": "#/$defs/stableId"
    },
    "revision_kind": {
      "type": "string",
      "enum": ["genesis", "successor"]
    },
    "genesis_reason": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "previous_revision_id": {
      "$ref": "#/$defs/stableId"
    },
    "previous_revision_path": {
      "$ref": "#/$defs/repositoryRelativePath"
    },
    "previous_revision_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidenceRecord"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["revision_kind"],
        "properties": {
          "revision_kind": {
            "const": "genesis"
          }
        }
      },
      "then": {
        "required": ["genesis_reason"],
        "allOf": [
          {
            "not": {
              "required": ["previous_revision_id"]
            }
          },
          {
            "not": {
              "required": ["previous_revision_path"]
            }
          },
          {
            "not": {
              "required": ["previous_revision_sha256"]
            }
          }
        ]
      }
    },
    {
      "if": {
        "required": ["revision_kind"],
        "properties": {
          "revision_kind": {
            "const": "successor"
          }
        }
      },
      "then": {
        "required": [
          "previous_revision_id",
          "previous_revision_path",
          "previous_revision_sha256"
        ],
        "not": {
          "required": ["genesis_reason"]
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "repositoryRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/].*$"
    },
    "coverageState": {
      "type": "string",
      "enum": [
        "unassessed",
        "missing",
        "partial",
        "implemented",
        "verified",
        "blocked",
        "intentional_difference",
        "not_applicable"
      ]
    },
    "proofLevel": {
      "type": "string",
      "enum": [
        "none",
        "source",
        "local_contract",
        "local_behavior",
        "target_environment",
        "user_value"
      ]
    },
    "freshness": {
      "type": "string",
      "enum": ["current", "stale", "superseded"]
    },
    "stringIdArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/stableId"
      }
    },
    "revisionBinding": {
      "type": "object",
      "required": [
        "binding_id",
        "revision_kind",
        "revision_value",
        "sha256"
      ],
      "properties": {
        "binding_id": {
          "$ref": "#/$defs/stableId"
        },
        "revision_kind": {
          "type": "string",
          "enum": [
            "revision_id",
            "git_commit",
            "content_tree_sha256",
            "artifact_sha256",
            "external_revision"
          ]
        },
        "revision_value": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "path": {
          "$ref": "#/$defs/repositoryRelativePath"
        },
        "uri": {
          "type": "string",
          "format": "uri",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "oneOf": [
        {
          "required": ["path"],
          "not": {
            "required": ["uri"]
          }
        },
        {
          "required": ["uri"],
          "not": {
            "required": ["path"]
          }
        }
      ],
      "additionalProperties": false
    },
    "environmentBinding": {
      "type": "object",
      "required": [
        "environment_id",
        "environment_kind",
        "platform",
        "fingerprint_sha256"
      ],
      "properties": {
        "environment_id": {
          "$ref": "#/$defs/stableId"
        },
        "environment_kind": {
          "type": "string",
          "enum": [
            "source_review",
            "local_contract",
            "local_behavior",
            "target_environment",
            "user_acceptance"
          ]
        },
        "platform": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "runtime": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "fingerprint_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "method": {
      "type": "object",
      "required": ["method_kind", "name"],
      "properties": {
        "method_kind": {
          "type": "string",
          "enum": [
            "source_inspection",
            "schema_validation",
            "command",
            "test",
            "build",
            "lint",
            "security_review",
            "manual_acceptance",
            "artifact_inspection",
            "external_receipt"
          ]
        },
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "command": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "actor": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["artifact_kind", "sha256"],
      "properties": {
        "artifact_kind": {
          "type": "string",
          "enum": ["repository_path", "external_uri"]
        },
        "path": {
          "$ref": "#/$defs/repositoryRelativePath"
        },
        "uri": {
          "type": "string",
          "format": "uri",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "media_type": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "byte_size": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["artifact_kind"],
            "properties": {
              "artifact_kind": {
                "const": "repository_path"
              }
            }
          },
          "then": {
            "required": ["path"],
            "not": {
              "required": ["uri"]
            }
          }
        },
        {
          "if": {
            "required": ["artifact_kind"],
            "properties": {
              "artifact_kind": {
                "const": "external_uri"
              }
            }
          },
          "then": {
            "required": ["uri"],
            "not": {
              "required": ["path"]
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "transitionEvent": {
      "type": "object",
      "required": ["event_type", "reason", "related_evidence_ids"],
      "properties": {
        "event_type": {
          "type": "string",
          "enum": ["stale", "supersession", "proof_decrease"]
        },
        "reason": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "related_evidence_ids": {
          "$ref": "#/$defs/stringIdArray"
        },
        "previous_proof_level": {
          "$ref": "#/$defs/proofLevel"
        },
        "current_proof_level": {
          "$ref": "#/$defs/proofLevel"
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["event_type"],
            "properties": {
              "event_type": {
                "const": "proof_decrease"
              }
            }
          },
          "then": {
            "required": ["previous_proof_level", "current_proof_level"]
          }
        }
      ],
      "additionalProperties": false
    },
    "evidenceRecord": {
      "type": "object",
      "required": [
        "sequence",
        "evidence_id",
        "subject_family",
        "subject_id",
        "subject_revision_id",
        "evidence_type",
        "result",
        "coverage_state",
        "proof_level",
        "freshness",
        "source_binding",
        "target_binding",
        "environment",
        "method",
        "observed_at",
        "artifact",
        "supersedes_evidence_ids",
        "previous_record_sha256",
        "record_sha256"
      ],
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "evidence_id": {
          "$ref": "#/$defs/stableId"
        },
        "subject_family": {
          "type": "string",
          "enum": [
            "official_source_artifact",
            "public_baseline",
            "repository_registry",
            "capability_decision",
            "evidence_index",
            "legacy_authority",
            "requirement",
            "journey",
            "capability",
            "repository"
          ]
        },
        "subject_id": {
          "$ref": "#/$defs/stableId"
        },
        "subject_revision_id": {
          "$ref": "#/$defs/stableId"
        },
        "evidence_type": {
          "type": "string",
          "enum": [
            "source_snapshot",
            "contract_check",
            "behavior_check",
            "target_environment_check",
            "user_acceptance",
            "review",
            "approval",
            "external_receipt",
            "failed_retest",
            "freshness_event",
            "supersession_event",
            "proof_change_event"
          ]
        },
        "result": {
          "type": "string",
          "enum": ["pass", "fail", "blocked", "skipped", "unknown"]
        },
        "coverage_state": {
          "$ref": "#/$defs/coverageState"
        },
        "proof_level": {
          "$ref": "#/$defs/proofLevel"
        },
        "freshness": {
          "$ref": "#/$defs/freshness"
        },
        "source_binding": {
          "$ref": "#/$defs/revisionBinding"
        },
        "target_binding": {
          "$ref": "#/$defs/revisionBinding"
        },
        "environment": {
          "$ref": "#/$defs/environmentBinding"
        },
        "method": {
          "$ref": "#/$defs/method"
        },
        "observed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "artifact": {
          "$ref": "#/$defs/artifact"
        },
        "supersedes_evidence_ids": {
          "$ref": "#/$defs/stringIdArray"
        },
        "transition_event": {
          "$ref": "#/$defs/transitionEvent"
        },
        "previous_record_sha256": {
          "oneOf": [
            {
              "const": "genesis"
            },
            {
              "$ref": "#/$defs/sha256"
            }
          ]
        },
        "record_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["freshness"],
            "properties": {
              "freshness": {
                "enum": ["stale", "superseded"]
              }
            }
          },
          "then": {
            "required": ["transition_event"]
          }
        },
        {
          "if": {
            "required": ["freshness"],
            "properties": {
              "freshness": {
                "const": "superseded"
              }
            }
          },
          "then": {
            "properties": {
              "transition_event": {
                "required": ["event_type"],
                "properties": {
                  "event_type": {
                    "const": "supersession"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["evidence_type"],
            "properties": {
              "evidence_type": {
                "const": "proof_change_event"
              }
            }
          },
          "then": {
            "required": ["transition_event"],
            "properties": {
              "transition_event": {
                "required": [
                  "event_type",
                  "previous_proof_level",
                  "current_proof_level"
                ],
                "properties": {
                  "event_type": {
                    "const": "proof_decrease"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "required": ["supersedes_evidence_ids"],
            "properties": {
              "supersedes_evidence_ids": {
                "minItems": 1
              }
            }
          },
          "then": {
            "required": ["transition_event"]
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
