{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-capability-governance-bundle.v1.schema.json",
  "title": "Kiana Capability Governance Bundle v1",
  "description": "Non-authoritative selector for exact canonical heads and auxiliary governance inputs. The checked-in evaluation time is deterministic validation configuration and is never derived from the process clock.",
  "type": "object",
  "required": [
    "schema",
    "version",
    "official_source_artifact",
    "public_baseline",
    "repository_registry",
    "capability_decisions",
    "evidence_head",
    "legacy_authority",
    "evaluation_time"
  ],
  "properties": {
    "schema": {
      "const": "kiana.capability-governance-bundle.v1"
    },
    "version": {
      "const": "1.0"
    },
    "official_source_artifact": {
      "$ref": "#/$defs/artifactBinding"
    },
    "public_baseline": {
      "$ref": "#/$defs/revisionHeadBinding"
    },
    "repository_registry": {
      "$ref": "#/$defs/revisionHeadBinding"
    },
    "capability_decisions": {
      "$ref": "#/$defs/revisionHeadBinding"
    },
    "evidence_head": {
      "$ref": "#/$defs/revisionHeadBinding"
    },
    "legacy_authority": {
      "$ref": "#/$defs/revisionHeadBinding"
    },
    "evaluation_time": {
      "$ref": "#/$defs/evaluationTime"
    }
  },
  "$defs": {
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "repositoryRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/].*$"
    },
    "evaluationTime": {
      "description": "Checked-in RFC3339 instant consumed by deterministic expiry checks.",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "artifactBinding": {
      "type": "object",
      "required": ["artifact_id", "path", "sha256"],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/stableId"
        },
        "path": {
          "$ref": "#/$defs/repositoryRelativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "revisionHeadBinding": {
      "type": "object",
      "required": ["revision_id", "path", "sha256"],
      "properties": {
        "revision_id": {
          "$ref": "#/$defs/stableId"
        },
        "path": {
          "$ref": "#/$defs/repositoryRelativePath"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
