{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-reference-repository-registry.v1.schema.json",
  "title": "Kiana Reference Repository Registry v1",
  "description": "Immutable identity, revision, license, and imported-domain registry for the frozen reference repository set. Registry coverage is not product completion.",
  "type": "object",
  "required": [
    "schema",
    "version",
    "revision_id",
    "revision_kind",
    "snapshot_id",
    "frozen_at",
    "expected_count",
    "repositories"
  ],
  "properties": {
    "schema": {
      "const": "kiana.reference-repository-registry.v1"
    },
    "version": {
      "const": "1.0"
    },
    "revision_id": {
      "$ref": "#/$defs/stableId"
    },
    "revision_kind": {
      "type": "string",
      "enum": ["genesis", "successor"]
    },
    "genesis_reason": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "previous_revision_id": {
      "$ref": "#/$defs/stableId"
    },
    "previous_revision_path": {
      "$ref": "#/$defs/repositoryRelativePath"
    },
    "previous_revision_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "snapshot_id": {
      "$ref": "#/$defs/stableId"
    },
    "frozen_at": {
      "$ref": "#/$defs/timestamp"
    },
    "expected_count": {
      "const": 38
    },
    "repositories": {
      "type": "array",
      "minItems": 38,
      "maxItems": 38,
      "items": {
        "$ref": "#/$defs/repository"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["revision_kind"],
        "properties": {
          "revision_kind": {
            "const": "genesis"
          }
        }
      },
      "then": {
        "required": ["genesis_reason"],
        "allOf": [
          {
            "not": {
              "required": ["previous_revision_id"]
            }
          },
          {
            "not": {
              "required": ["previous_revision_path"]
            }
          },
          {
            "not": {
              "required": ["previous_revision_sha256"]
            }
          }
        ]
      }
    },
    {
      "if": {
        "required": ["revision_kind"],
        "properties": {
          "revision_kind": {
            "const": "successor"
          }
        }
      },
      "then": {
        "required": [
          "previous_revision_id",
          "previous_revision_path",
          "previous_revision_sha256"
        ],
        "not": {
          "required": ["genesis_reason"]
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "gitHead": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "repositoryRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/].*$"
    },
    "stringIdArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/stableId"
      }
    },
    "upstream": {
      "type": "object",
      "required": ["kind", "locator"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["git", "content_snapshot", "unknown"]
        },
        "locator": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "alias": {
      "type": "object",
      "required": [
        "kind",
        "value",
        "change_kind",
        "reason",
        "effective_at",
        "evidence_ids",
        "review_revision"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["repo_id", "path"]
        },
        "value": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "change_kind": {
          "type": "string",
          "enum": ["renamed", "removed", "replaced"]
        },
        "reason": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "effective_at": {
          "$ref": "#/$defs/timestamp"
        },
        "evidence_ids": {
          "allOf": [
            {
              "$ref": "#/$defs/stringIdArray"
            },
            {
              "minItems": 1
            }
          ]
        },
        "review_revision": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false
    },
    "repository": {
      "type": "object",
      "required": [
        "repo_id",
        "path",
        "upstream",
        "availability",
        "scanned_at",
        "freshness",
        "revision_kind",
        "revision_value",
        "tree_sha256",
        "license_sha256",
        "license_status",
        "license_expression",
        "license_compatibility",
        "license_evidence_ids",
        "domains",
        "aliases",
        "inventory_capability_ids"
      ],
      "properties": {
        "repo_id": {
          "$ref": "#/$defs/stableId"
        },
        "path": {
          "type": "string",
          "pattern": "^reference/[^/].*$"
        },
        "upstream": {
          "$ref": "#/$defs/upstream"
        },
        "availability": {
          "type": "string",
          "enum": ["available", "missing", "unreadable"]
        },
        "scanned_at": {
          "$ref": "#/$defs/timestamp"
        },
        "freshness": {
          "type": "string",
          "enum": ["current", "stale", "superseded"]
        },
        "revision_kind": {
          "type": "string",
          "enum": ["git_commit", "content_tree_sha256"]
        },
        "revision_value": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$"
        },
        "git_head": {
          "$ref": "#/$defs/gitHead"
        },
        "tree_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "license_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "license_status": {
          "type": "string",
          "enum": ["found", "missing", "conflicting", "unreadable"]
        },
        "license_expression": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "license_compatibility": {
          "type": "string",
          "enum": ["compatible", "incompatible", "review_required", "unknown"]
        },
        "license_evidence_ids": {
          "allOf": [
            {
              "$ref": "#/$defs/stringIdArray"
            },
            {
              "minItems": 1
            }
          ]
        },
        "domains": {
          "description": "Imported compatibility classification labels only; domains never represent proof, a decision, or product completion.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^D[0-9]{2}$"
          }
        },
        "aliases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/alias"
          }
        },
        "inventory_capability_ids": {
          "allOf": [
            {
              "$ref": "#/$defs/stringIdArray"
            },
            {
              "minItems": 1
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["revision_kind"],
            "properties": {
              "revision_kind": {
                "const": "git_commit"
              }
            }
          },
          "then": {
            "required": ["git_head"]
          }
        },
        {
          "if": {
            "required": ["revision_kind"],
            "properties": {
              "revision_kind": {
                "const": "content_tree_sha256"
              }
            }
          },
          "then": {
            "properties": {
              "revision_value": {
                "$ref": "#/$defs/sha256"
              }
            },
            "not": {
              "required": ["git_head"]
            }
          }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
