{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-approval-challenge.v1.schema.json",
  "title": "Kiana Approval Challenge v1",
  "type": "object",
  "required": [
    "schema",
    "approval_id",
    "request_id",
    "request_hash",
    "expires_at_unix_ms",
    "reason"
  ],
  "properties": {
    "schema": {
      "const": "kiana.approval-challenge.v1"
    },
    "approval_id": {
      "type": "string",
      "format": "uuid"
    },
    "request_id": {
      "type": "string",
      "format": "uuid"
    },
    "request_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "expires_at_unix_ms": {
      "type": "integer",
      "minimum": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
