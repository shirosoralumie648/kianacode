{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-enterprise-offline-manifest.v1.schema.json",
  "title": "Kiana Enterprise Offline Manifest v1",
  "type": "object",
  "required": [
    "schema",
    "version",
    "release_base_url",
    "artifacts",
    "channels",
    "generated_by"
  ],
  "properties": {
    "schema": {
      "const": "kiana.enterprise.offline-manifest.v1"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "release_base_url": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "target",
          "archive",
          "url",
          "sha256",
          "binary_sha256",
          "local_path",
          "checksum_path",
          "binary_checksum_path"
        ],
        "properties": {
          "target": {
            "type": "string",
            "minLength": 1
          },
          "archive": {
            "type": "string",
            "pattern": "^kiana-.+[.]tar[.]gz$"
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "binary_sha256": {
            "type": "string",
            "pattern": "^$|^[a-fA-F0-9]{64}$"
          },
          "local_path": {
            "type": "string",
            "pattern": "^kiana-.+[.]tar[.]gz$"
          },
          "checksum_path": {
            "type": "string",
            "pattern": "^kiana-.+[.]tar[.]gz[.]sha256$"
          },
          "binary_checksum_path": {
            "type": "string",
            "pattern": "^kiana-.+[.]binary[.]sha256$"
          }
        },
        "additionalProperties": false
      }
    },
    "channels": {
      "type": "object",
      "required": ["github_releases", "homebrew", "winget"],
      "properties": {
        "github_releases": {
          "type": "string",
          "minLength": 1
        },
        "homebrew": {
          "type": "string",
          "minLength": 1
        },
        "winget": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "generated_by": {
      "const": "scripts/generate-distribution-manifests.sh"
    }
  },
  "additionalProperties": false
}
