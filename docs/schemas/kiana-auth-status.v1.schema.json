{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-auth-status.v1.schema.json",
  "title": "Kiana Auth Status v1",
  "type": "object",
  "required": ["schema", "api_key", "source", "config_file", "oauth", "providers"],
  "properties": {
    "schema": {
      "const": "kiana.auth-status.v1"
    },
    "api_key": {
      "type": "string",
      "enum": ["set", "missing"]
    },
    "source": {
      "type": "string"
    },
    "config_file": {
      "type": "string"
    },
    "oauth": {
      "type": "object",
      "required": [
        "status",
        "access_token",
        "refresh_token",
        "file",
        "store",
        "expires_at",
        "expired",
        "expiring",
        "refreshable",
        "error"
      ],
      "properties": {
        "status": {
          "type": "string"
        },
        "access_token": {
          "type": "string"
        },
        "refresh_token": {
          "type": "string"
        },
        "file": {
          "type": "string"
        },
        "store": {
          "type": "string"
        },
        "expires_at": {
          "type": ["string", "null"]
        },
        "expired": {
          "type": "boolean"
        },
        "expiring": {
          "type": "boolean"
        },
        "refreshable": {
          "type": "boolean"
        },
        "error": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "providers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/provider"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "provider": {
      "type": "object",
      "required": [
        "provider_id",
        "display_name",
        "auth",
        "status",
        "auth_source",
        "key_preview",
        "base_url",
        "model_id",
        "default_model_id",
        "protocol",
        "models_source",
        "requires_live_smoke"
      ],
      "properties": {
        "provider_id": {
          "type": "string",
          "minLength": 1
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "auth": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "auth_source": {
          "type": "string"
        },
        "key_preview": {
          "type": "string"
        },
        "base_url": {
          "type": ["string", "null"]
        },
        "model_id": {
          "type": "string"
        },
        "default_model_id": {
          "type": "string"
        },
        "protocol": {
          "type": "string",
          "enum": [
            "anthropic_messages",
            "open_ai_chat_completions",
            "ollama_chat",
            "fake"
          ]
        },
        "models_source": {
          "type": "string",
          "enum": [
            "static_table",
            "user_configured",
            "local_service",
            "deterministic_test"
          ]
        },
        "requires_live_smoke": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
