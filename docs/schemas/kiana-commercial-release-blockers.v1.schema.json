{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-commercial-release-blockers.v1.schema.json",
  "title": "Kiana Commercial Release Blockers v1",
  "type": "object",
  "required": [
    "schema",
    "version",
    "generated_at",
    "status",
    "release_tag",
    "summary",
    "checks"
  ],
  "properties": {
    "schema": {
      "const": "kiana.commercial-release-blockers.v1"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["ready", "blocked"]
    },
    "release_tag": {
      "type": "string",
      "pattern": "^v[0-9]+[.][0-9]+[.][0-9]+"
    },
    "summary": {
      "type": "object",
      "required": [
        "total_checks",
        "satisfied",
        "blocking",
        "external_blocking",
        "local_blocking",
        "blocking_by_resolution_scope"
      ],
      "properties": {
        "total_checks": {
          "type": "integer",
          "minimum": 0
        },
        "satisfied": {
          "type": "integer",
          "minimum": 0
        },
        "blocking": {
          "type": "integer",
          "minimum": 0
        },
        "external_blocking": {
          "type": "integer",
          "minimum": 0
        },
        "local_blocking": {
          "type": "integer",
          "minimum": 0
        },
        "blocking_by_resolution_scope": {
          "type": "object",
          "required": [
            "local-automation",
            "release-owner",
            "release-security",
            "release-environment",
            "final-artifact-derived",
            "live-service",
            "acceptance-owner"
          ],
          "properties": {
            "local-automation": {
              "type": "integer",
              "minimum": 0
            },
            "release-owner": {
              "type": "integer",
              "minimum": 0
            },
            "release-security": {
              "type": "integer",
              "minimum": 0
            },
            "release-environment": {
              "type": "integer",
              "minimum": 0
            },
            "final-artifact-derived": {
              "type": "integer",
              "minimum": 0
            },
            "live-service": {
              "type": "integer",
              "minimum": 0
            },
            "acceptance-owner": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "severity",
          "status",
          "external",
          "title",
          "gate",
          "evidence",
          "required_action",
          "paths",
          "commands",
          "env",
          "owner",
          "owner_status",
          "resolution_scope",
          "acceptance_artifacts",
          "verification_commands",
          "handoff_notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]*$"
          },
          "category": {
            "type": "string",
            "enum": [
              "source-control",
              "build-test",
              "signing",
              "distribution",
              "live-service",
              "acceptance"
            ]
          },
          "severity": {
            "type": "string",
            "enum": ["blocker", "warning", "info"]
          },
          "status": {
            "type": "string",
            "enum": ["satisfied", "blocking"]
          },
          "external": {
            "type": "boolean"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "gate": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string"
          },
          "required_action": {
            "type": "string",
            "minLength": 1
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "commands": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "env": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "owner_status": {
            "type": "string",
            "enum": ["local-owner", "role-owner-required", "specific-owner-assigned"]
          },
          "resolution_scope": {
            "type": "string",
            "enum": [
              "local-automation",
              "release-owner",
              "release-security",
              "release-environment",
              "final-artifact-derived",
              "live-service",
              "acceptance-owner"
            ]
          },
          "acceptance_artifacts": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verification_commands": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "handoff_notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
