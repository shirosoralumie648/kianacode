{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-team-plan.v1.schema.json",
  "title": "Kiana Team Plan v1",
  "type": "object",
  "required": [
    "schema",
    "workspace",
    "team",
    "task_list",
    "role_runtime",
    "roles",
    "artifact_readiness",
    "tasks"
  ],
  "properties": {
    "schema": { "const": "kiana.team-plan.v1" },
    "workspace": { "type": "string", "minLength": 1 },
    "team": {
      "type": "object",
      "required": ["name", "source"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "source": {
          "enum": ["team_context", "task_list_id", "session_id", "default_task_list"]
        }
      },
      "additionalProperties": false
    },
    "task_list": {
      "type": "object",
      "required": ["id", "tasks_dir", "count", "status_counts"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "tasks_dir": { "type": "string", "minLength": 1 },
        "count": { "type": "integer", "minimum": 0 },
        "status_counts": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        }
      },
      "additionalProperties": false
    },
    "role_runtime": {
      "type": "object",
      "required": [
        "status",
        "ready_for_fake_runtime",
        "required_roles",
        "missing_roles",
        "role_task_count",
        "blocked_task_count",
        "dependency_edge_count"
      ],
      "properties": {
        "status": { "type": "string", "enum": ["ready", "incomplete"] },
        "ready_for_fake_runtime": { "type": "boolean" },
        "required_roles": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "missing_roles": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "role_task_count": { "type": "integer", "minimum": 0 },
        "blocked_task_count": { "type": "integer", "minimum": 0 },
        "dependency_edge_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "roles": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "aliases",
          "present",
          "task_count",
          "open_task_count",
          "completed_task_count",
          "task_ids"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "aliases": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "present": { "type": "boolean" },
          "task_count": { "type": "integer", "minimum": 0 },
          "open_task_count": { "type": "integer", "minimum": 0 },
          "completed_task_count": { "type": "integer", "minimum": 0 },
          "task_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    },
    "artifact_readiness": {
      "type": "object",
      "required": ["status", "required_roles", "missing_roles"],
      "properties": {
        "status": { "type": "string", "enum": ["ready", "incomplete"] },
        "required_roles": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "required": ["role", "present", "count", "task_ids"],
            "properties": {
              "role": { "type": "string", "minLength": 1 },
              "present": { "type": "boolean" },
              "count": { "type": "integer", "minimum": 0 },
              "task_ids": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              }
            },
            "additionalProperties": false
          }
        },
        "missing_roles": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "tasks": {
      "type": "object",
      "required": ["schema", "task_list_id", "tasks_dir", "count", "status_counts", "tasks"],
      "properties": {
        "schema": { "const": "kiana.tasks.v1" },
        "task_list_id": { "type": "string", "minLength": 1 },
        "tasks_dir": { "type": "string", "minLength": 1 },
        "count": { "type": "integer", "minimum": 0 },
        "status_counts": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "tasks": { "type": "array" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
