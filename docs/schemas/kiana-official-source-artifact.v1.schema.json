{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-official-source-artifact.v1.schema.json",
  "title": "Kiana Official Source Artifact v1",
  "description": "Controlled, immutable normalization of an official public source. Structural validity does not prove semantic source coverage.",
  "type": "object",
  "required": [
    "schema",
    "version",
    "revision_id",
    "revision_kind",
    "artifact_id",
    "source_kind",
    "official_uri",
    "archive_uri",
    "retrieved_at",
    "applicable_product_version",
    "normalization",
    "content_sha256",
    "entries"
  ],
  "properties": {
    "schema": {
      "const": "kiana.official-source-artifact.v1"
    },
    "version": {
      "const": "1.0"
    },
    "revision_id": {
      "$ref": "#/$defs/stableId"
    },
    "revision_kind": {
      "type": "string",
      "enum": ["genesis", "successor"]
    },
    "genesis_reason": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "previous_revision_id": {
      "$ref": "#/$defs/stableId"
    },
    "previous_revision_path": {
      "$ref": "#/$defs/repositoryRelativePath"
    },
    "previous_revision_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "artifact_id": {
      "$ref": "#/$defs/stableId"
    },
    "source_kind": {
      "const": "official_public"
    },
    "official_uri": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "minLength": 9
    },
    "archive_uri": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "minLength": 9
    },
    "retrieved_at": {
      "$ref": "#/$defs/timestamp"
    },
    "applicable_product_version": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "normalization": {
      "$ref": "#/$defs/normalization"
    },
    "content_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourceEntry"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["revision_kind"],
        "properties": {
          "revision_kind": {
            "const": "genesis"
          }
        }
      },
      "then": {
        "required": ["genesis_reason"],
        "allOf": [
          {
            "not": {
              "required": ["previous_revision_id"]
            }
          },
          {
            "not": {
              "required": ["previous_revision_path"]
            }
          },
          {
            "not": {
              "required": ["previous_revision_sha256"]
            }
          }
        ]
      }
    },
    {
      "if": {
        "required": ["revision_kind"],
        "properties": {
          "revision_kind": {
            "const": "successor"
          }
        }
      },
      "then": {
        "required": [
          "previous_revision_id",
          "previous_revision_path",
          "previous_revision_sha256"
        ],
        "not": {
          "required": ["genesis_reason"]
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "repositoryRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/].*$"
    },
    "normalization": {
      "type": "object",
      "required": [
        "method",
        "version",
        "content_format",
        "line_endings",
        "unicode_normalization"
      ],
      "properties": {
        "method": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "content_format": {
          "type": "string",
          "enum": ["plain_text", "markdown", "json"]
        },
        "line_endings": {
          "const": "lf"
        },
        "unicode_normalization": {
          "type": "string",
          "enum": ["NFC", "NFKC", "none"]
        }
      },
      "additionalProperties": false
    },
    "sourceEntry": {
      "type": "object",
      "required": [
        "source_entry_id",
        "locator",
        "title",
        "kind",
        "entry_sha256"
      ],
      "properties": {
        "source_entry_id": {
          "$ref": "#/$defs/stableId"
        },
        "locator": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "kind": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "entry_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
