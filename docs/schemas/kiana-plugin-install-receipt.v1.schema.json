{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-plugin-install-receipt.v1.schema.json",
  "title": "Kiana Plugin Install Receipt v1",
  "type": "object",
  "required": [
    "schema",
    "name",
    "source_type",
    "source_path",
    "install_path",
    "policy",
    "file_count",
    "content_hash",
    "files",
    "integrity"
  ],
  "properties": {
    "schema": {
      "const": "kiana.plugin-install-receipt.v1"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "source_type": {
      "type": "string",
      "enum": ["path", "marketplace"]
    },
    "source_path": {
      "type": "string",
      "minLength": 1
    },
    "install_path": {
      "type": "string",
      "minLength": 1
    },
    "marketplace": {
      "type": "string",
      "minLength": 1
    },
    "policy": {
      "type": "object",
      "properties": {
        "installPolicy": {
          "type": "string"
        },
        "authPolicy": {
          "type": "string"
        },
        "availability": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "managed_policy": {
      "type": "object",
      "required": ["source", "decision", "reason"],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "type": "string",
          "enum": ["allowed"]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "file_count": {
      "type": "integer",
      "minimum": 0
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "bytes", "content_hash"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "content_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{16}$"
          }
        },
        "additionalProperties": false
      }
    },
    "integrity": {
      "type": "object",
      "required": ["method", "payload_hash"],
      "properties": {
        "method": {
          "const": "stable-hash-v1"
        },
        "payload_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
