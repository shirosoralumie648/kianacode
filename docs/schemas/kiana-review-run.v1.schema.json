{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-review-run.v1.schema.json",
  "title": "Kiana Review Run v1",
  "type": "object",
  "required": [
    "schema",
    "root",
    "inside_git_repo",
    "dry_run",
    "dirty",
    "files",
    "patches",
    "checks",
    "findings"
  ],
  "properties": {
    "schema": {
      "const": "kiana.review.run.v1"
    },
    "root": {
      "type": "string",
      "minLength": 1
    },
    "git_root": {
      "type": "string",
      "minLength": 1
    },
    "inside_git_repo": {
      "type": "boolean"
    },
    "dry_run": {
      "const": false
    },
    "dirty": {
      "type": "boolean"
    },
    "head": {
      "type": "string",
      "minLength": 1
    },
    "branch": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reviewFile"
      }
    },
    "patches": {
      "$ref": "#/$defs/reviewPatches"
    },
    "checks": {
      "$ref": "#/$defs/checksRun"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reviewFinding"
      }
    }
  },
  "$defs": {
    "reviewFile": {
      "type": "object",
      "required": ["path", "index", "worktree"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "index": {
          "type": "string",
          "minLength": 1
        },
        "worktree": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "reviewPatches": {
      "type": "object",
      "required": ["staged", "unstaged"],
      "properties": {
        "staged": {
          "$ref": "#/$defs/patchPreview"
        },
        "unstaged": {
          "$ref": "#/$defs/patchPreview"
        }
      },
      "additionalProperties": false
    },
    "patchPreview": {
      "type": "object",
      "required": ["changed", "bytes", "text"],
      "properties": {
        "changed": {
          "type": "boolean"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "checksRun": {
      "type": "object",
      "required": [
        "schema",
        "root",
        "inside_git_repo",
        "dry_run",
        "execution",
        "summary",
        "results"
      ],
      "properties": {
        "schema": {
          "const": "kiana.checks.run.v1"
        },
        "root": {
          "type": "string",
          "minLength": 1
        },
        "git_root": {
          "type": "string",
          "minLength": 1
        },
        "inside_git_repo": {
          "type": "boolean"
        },
        "dry_run": {
          "const": false
        },
        "execution": {
          "type": "object",
          "required": ["isolation", "applied_current_changes"],
          "properties": {
            "isolation": {
              "type": "string",
              "enum": ["git_worktree", "none"]
            },
            "applied_current_changes": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "summary": {
          "type": "object",
          "required": ["total", "passed", "failed", "skipped"],
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "passed": {
              "type": "integer",
              "minimum": 0
            },
            "failed": {
              "type": "integer",
              "minimum": 0
            },
            "skipped": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/checkResult"
          }
        }
      },
      "additionalProperties": false
    },
    "checkResult": {
      "type": "object",
      "required": [
        "id",
        "description",
        "command",
        "status",
        "stdout",
        "stderr"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": ["passed", "failed", "skipped"]
        },
        "exit_code": {
          "type": ["integer", "null"]
        },
        "stdout": {
          "type": "string"
        },
        "stderr": {
          "type": "string"
        },
        "error": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "reviewFinding": {
      "type": "object",
      "required": ["kind", "severity", "check_id", "message"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["check_failed", "check_skipped"]
        },
        "severity": {
          "type": "string",
          "enum": ["error", "warning"]
        },
        "check_id": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
