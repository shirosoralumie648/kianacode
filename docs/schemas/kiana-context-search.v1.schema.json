{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-context-search.v1.schema.json",
  "title": "Kiana Context Search v1",
  "type": "object",
  "required": [
    "schema",
    "root",
    "query",
    "terms",
    "limit",
    "files_indexed",
    "skipped_files",
    "hits"
  ],
  "properties": {
    "schema": {
      "const": "kiana.context-search.v1"
    },
    "root": {
      "type": "string",
      "minLength": 1
    },
    "query": {
      "type": "string"
    },
    "terms": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limit": {
      "type": "integer",
      "minimum": 1
    },
    "files_indexed": {
      "type": "integer",
      "minimum": 0
    },
    "skipped_files": {
      "type": "integer",
      "minimum": 0
    },
    "hits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "language",
          "score",
          "occurrences",
          "matched_terms",
          "line_number",
          "line"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "type": ["string", "null"]
          },
          "score": {
            "type": "integer",
            "minimum": 0
          },
          "occurrences": {
            "type": "integer",
            "minimum": 0
          },
          "matched_terms": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "line_number": {
            "type": "integer",
            "minimum": 0
          },
          "line": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
