{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-entitlement-proof.v1.schema.json",
  "title": "Kiana Entitlement Proof v1",
  "type": "object",
  "required": [
    "schema",
    "version",
    "status",
    "accepted",
    "accepted_by",
    "accepted_at",
    "account_id",
    "organization",
    "plan",
    "license_status",
    "entitlements",
    "license_key_fingerprint",
    "support_contact",
    "backend"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "accepted"
          }
        }
      },
      "then": {
        "properties": {
          "accepted": {
            "const": true
          },
          "accepted_by": {
            "minLength": 1
          },
          "accepted_at": {
            "minLength": 1
          },
          "account_id": {
            "minLength": 1
          },
          "organization": {
            "minLength": 1
          },
          "plan": {
            "minLength": 1
          },
          "license_status": {
            "const": "active"
          },
          "entitlements": {
            "minItems": 1
          },
          "license_key_fingerprint": {
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "support_contact": {
            "minLength": 1
          },
          "backend": {
            "properties": {
              "name": {
                "minLength": 1
              },
              "environment": {
                "minLength": 1
              },
              "checked_at": {
                "minLength": 1
              },
              "request_id": {
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "accepted": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "accepted"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": ["local_rc_only", "blocked"]
          }
        }
      },
      "then": {
        "properties": {
          "accepted": {
            "const": false
          }
        }
      }
    }
  ],
  "properties": {
    "schema": {
      "const": "kiana.entitlement-proof.v1"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["accepted", "local_rc_only", "blocked"]
    },
    "accepted": {
      "type": "boolean"
    },
    "accepted_by": {
      "type": "string"
    },
    "accepted_at": {
      "type": "string"
    },
    "account_id": {
      "type": "string"
    },
    "organization": {
      "type": "string"
    },
    "plan": {
      "type": "string"
    },
    "license_status": {
      "type": "string",
      "enum": ["active", "trial", "suspended", "expired", "missing", "blocked"]
    },
    "entitlements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "license_key_fingerprint": {
      "type": "string"
    },
    "expires_at": {
      "type": "string"
    },
    "support_contact": {
      "type": "string"
    },
    "backend": {
      "type": "object",
      "required": ["name", "environment", "checked_at", "request_id"],
      "properties": {
        "name": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        },
        "checked_at": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
