{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-context-artifacts.v1.schema.json",
  "title": "Kiana Context Artifacts v1",
  "type": "object",
  "required": [
    "schema",
    "root",
    "files_indexed",
    "skipped_files",
    "artifacts"
  ],
  "properties": {
    "schema": {
      "const": "kiana.context-artifacts.v1"
    },
    "root": {
      "type": "string",
      "minLength": 1
    },
    "files_indexed": {
      "type": "integer",
      "minimum": 0
    },
    "skipped_files": {
      "type": "integer",
      "minimum": 0
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "path",
          "language",
          "bytes",
          "line_count",
          "content_hash"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^file:.+:[0-9a-f]{16}$"
          },
          "kind": {
            "const": "file"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "type": ["string", "null"]
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "line_count": {
            "type": "integer",
            "minimum": 0
          },
          "content_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{16}$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
