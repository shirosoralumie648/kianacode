{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-checks-dry-run.v1.schema.json",
  "title": "Kiana Checks Dry Run v1",
  "type": "object",
  "required": ["schema", "root", "inside_git_repo", "dry_run", "checks"],
  "properties": {
    "schema": {
      "const": "kiana.checks.dry_run.v1"
    },
    "root": {
      "type": "string",
      "minLength": 1
    },
    "git_root": {
      "type": "string",
      "minLength": 1
    },
    "inside_git_repo": {
      "type": "boolean"
    },
    "dry_run": {
      "const": true
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "command"],
        "properties": {
          "id": {
            "type": "string",
            "enum": ["rustfmt", "cargo_check", "cargo_test", "release_smoke"]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "command": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
