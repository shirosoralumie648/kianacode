{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-swarm-worker-state.v2.schema.json",
  "title": "Kiana Bounded Swarm Worker State v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "worker_id",
    "dispatch_id",
    "task_id",
    "status",
    "pid",
    "process_identity",
    "process_identity_status",
    "process_identity_reason",
    "attempt",
    "started_at_ms",
    "finished_at_ms",
    "exit_code",
    "termination_reason",
    "output_bytes",
    "result_path",
    "updated_at_ms"
  ],
  "properties": {
    "schema": { "const": "kiana.swarm-worker-state.v2" },
    "worker_id": { "type": "string", "minLength": 1 },
    "dispatch_id": { "type": "string", "minLength": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "completed",
        "failed",
        "cancelled",
        "timeout",
        "budget_exhausted",
        "scope_violation",
        "lost"
      ]
    },
    "pid": { "type": "integer", "minimum": 1 },
    "process_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "platform",
        "pid",
        "process_group_id",
        "start_time_ticks",
        "command_sha256"
      ],
      "properties": {
        "schema": { "const": "kiana.swarm-process-identity.v1" },
        "platform": { "const": "linux_procfs" },
        "pid": { "type": "integer", "minimum": 1 },
        "process_group_id": { "type": "integer", "minimum": 1 },
        "start_time_ticks": { "type": "integer", "minimum": 1 },
        "command_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "process_identity_status": {
      "type": "string",
      "enum": ["verified", "exited", "missing", "mismatch", "unavailable"]
    },
    "process_identity_reason": {
      "type": ["string", "null"]
    },
    "attempt": { "type": "integer", "minimum": 1 },
    "started_at_ms": { "type": "integer", "minimum": 0 },
    "finished_at_ms": { "type": ["integer", "null"], "minimum": 0 },
    "exit_code": { "type": ["integer", "null"] },
    "termination_reason": { "type": ["string", "null"] },
    "output_bytes": { "type": "integer", "minimum": 0 },
    "result_path": { "type": ["string", "null"] },
    "updated_at_ms": { "type": "integer", "minimum": 0 }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "running" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "process_identity_status": { "const": "verified" },
          "finished_at_ms": { "type": "null" },
          "exit_code": { "type": "null" },
          "termination_reason": { "type": "null" },
          "result_path": { "type": "null" }
        }
      }
    }
  ]
}
