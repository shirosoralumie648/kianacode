{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-legacy-authority-classification.v1.schema.json",
  "title": "Kiana Legacy Authority Classification v1",
  "description": "Immutable, hash-bound classification of legacy governance inputs and generated views. Every inventoried path identifies its canonical replacement and review evidence.",
  "type": "object",
  "required": [
    "schema",
    "version",
    "revision_id",
    "revision_kind",
    "inventory_globs",
    "review_revision",
    "reviewed_at",
    "entries"
  ],
  "properties": {
    "schema": {
      "const": "kiana.legacy-authority-classification.v1"
    },
    "version": {
      "const": "1.0"
    },
    "revision_id": {
      "$ref": "#/$defs/stableId"
    },
    "revision_kind": {
      "type": "string",
      "enum": ["genesis", "successor"]
    },
    "genesis_reason": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "previous_revision_id": {
      "$ref": "#/$defs/stableId"
    },
    "previous_revision_path": {
      "$ref": "#/$defs/repositoryRelativePath"
    },
    "previous_revision_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "inventory_globs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/repositoryRelativeGlob"
      }
    },
    "review_revision": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "reviewed_at": {
      "$ref": "#/$defs/timestamp"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/legacyEntry"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["revision_kind"],
        "properties": {
          "revision_kind": {
            "const": "genesis"
          }
        }
      },
      "then": {
        "required": ["genesis_reason"],
        "allOf": [
          {
            "not": {
              "required": ["previous_revision_id"]
            }
          },
          {
            "not": {
              "required": ["previous_revision_path"]
            }
          },
          {
            "not": {
              "required": ["previous_revision_sha256"]
            }
          }
        ]
      }
    },
    {
      "if": {
        "required": ["revision_kind"],
        "properties": {
          "revision_kind": {
            "const": "successor"
          }
        }
      },
      "then": {
        "required": [
          "previous_revision_id",
          "previous_revision_path",
          "previous_revision_sha256"
        ],
        "not": {
          "required": ["genesis_reason"]
        }
      }
    }
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stableId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "repositoryRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/].*$"
    },
    "repositoryRelativeGlob": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/].*$"
    },
    "stringIdArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/stableId"
      }
    },
    "legacyEntry": {
      "type": "object",
      "required": [
        "path",
        "content_sha256",
        "classification",
        "rationale",
        "replacement_view",
        "evidence_ids",
        "review_revision"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repositoryRelativePath"
        },
        "content_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "classification": {
          "type": "string",
          "enum": [
            "generated_projection",
            "frozen_migration_input",
            "narrative_no_status"
          ]
        },
        "rationale": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "replacement_view": {
          "$ref": "#/$defs/repositoryRelativePath"
        },
        "evidence_ids": {
          "$ref": "#/$defs/stringIdArray"
        },
        "review_revision": {
          "$ref": "#/$defs/nonEmptyString"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
