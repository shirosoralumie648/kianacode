{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-eval-baseline.v1.schema.json",
  "title": "Kiana Eval Baseline v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "suite_id", "cases"],
  "properties": {
    "schema": { "const": "kiana.eval-baseline.v1" },
    "suite_id": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "cases": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 256,
      "propertyNames": { "type": "string", "minLength": 1 },
      "additionalProperties": { "$ref": "#/$defs/caseBaseline" }
    }
  },
  "$defs": {
    "caseBaseline": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "max_event_count": { "type": "integer", "minimum": 0 },
        "max_tool_call_count": { "type": "integer", "minimum": 0 },
        "max_tool_result_count": { "type": "integer", "minimum": 0 },
        "max_tool_error_count": { "type": "integer", "minimum": 0 },
        "max_input_tokens": { "type": "integer", "minimum": 0 },
        "max_output_tokens": { "type": "integer", "minimum": 0 },
        "required_status": { "type": "string", "minLength": 1 },
        "required_stop_reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
