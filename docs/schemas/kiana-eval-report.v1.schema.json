{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-eval-report.v1.schema.json",
  "title": "Kiana Eval Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "suite_id", "suite_sha256", "status", "summary", "baseline", "cases"],
  "properties": {
    "schema": { "const": "kiana.eval-report.v1" },
    "suite_id": { "type": "string", "minLength": 1 },
    "suite_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "status": { "enum": ["passed", "failed"] },
    "summary": { "$ref": "#/$defs/summary" },
    "baseline": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/baselineReport" }
      ]
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/caseReport" }
    }
  },
  "$defs": {
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "passed", "failed", "events", "tool_calls", "tool_errors"],
      "properties": {
        "total": { "type": "integer", "minimum": 1 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "events": { "type": "integer", "minimum": 0 },
        "tool_calls": { "type": "integer", "minimum": 0 },
        "tool_errors": { "type": "integer", "minimum": 0 }
      }
    },
    "caseReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "fixture", "fixture_sha256", "status", "metrics", "findings"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "const": "runtime_event_replay" },
        "fixture": { "type": "string", "minLength": 1 },
        "fixture_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "status": { "enum": ["passed", "failed"] },
        "metrics": { "$ref": "#/$defs/metrics" },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/finding" }
        }
      }
    },
    "baselineReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "provided", "path", "sha256", "suite_id", "status", "findings"],
      "properties": {
        "schema": { "const": "kiana.eval-baseline.v1" },
        "provided": { "const": true },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "suite_id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["passed", "failed"] },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/finding" }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_count",
        "event_type_counts",
        "assistant_text_count",
        "tool_call_count",
        "tool_result_count",
        "tool_error_count",
        "tool_names",
        "input_tokens",
        "output_tokens",
        "final_status",
        "stop_reason",
        "final_text"
      ],
      "properties": {
        "event_count": { "type": "integer", "minimum": 0 },
        "event_type_counts": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "assistant_text_count": { "type": "integer", "minimum": 0 },
        "tool_call_count": { "type": "integer", "minimum": 0 },
        "tool_result_count": { "type": "integer", "minimum": 0 },
        "tool_error_count": { "type": "integer", "minimum": 0 },
        "tool_names": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "final_status": { "type": ["string", "null"] },
        "stop_reason": { "type": ["string", "null"] },
        "final_text": { "type": ["string", "null"] }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "expected", "actual", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "expected": {},
        "actual": {},
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
