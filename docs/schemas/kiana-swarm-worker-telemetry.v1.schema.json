{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-swarm-worker-telemetry.v1.schema.json",
  "title": "Kiana Bounded Swarm Worker Telemetry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "provided",
    "command_count",
    "commands_run",
    "invalid_command_entries",
    "raw_sha256",
    "notes"
  ],
  "properties": {
    "schema": { "const": "kiana.swarm-worker-telemetry.v1" },
    "provided": { "type": "boolean" },
    "command_count": { "type": "integer", "minimum": 0 },
    "commands_run": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "invalid_command_entries": { "type": "integer", "minimum": 0 },
    "raw_sha256": {
      "type": ["string", "null"],
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "provided": { "const": false } },
        "required": ["provided"]
      },
      "then": {
        "properties": {
          "command_count": { "const": 0 },
          "commands_run": { "const": [] },
          "invalid_command_entries": { "const": 0 },
          "raw_sha256": { "type": "null" }
        }
      }
    }
  ]
}
