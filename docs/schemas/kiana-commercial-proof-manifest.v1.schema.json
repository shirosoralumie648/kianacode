{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-commercial-proof-manifest.v1.schema.json",
  "title": "Kiana Commercial Proof Manifest v1",
  "type": "object",
  "required": [
    "schema",
    "version",
    "generated_at",
    "proof_root",
    "summary",
    "proofs"
  ],
  "properties": {
    "schema": {
      "const": "kiana.commercial-proof-manifest.v1"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "proof_root": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "object",
      "required": [
        "proofs",
        "accepted",
        "live",
        "platforms"
      ],
      "properties": {
        "proofs": {
          "type": "integer",
          "minimum": 0
        },
        "accepted": {
          "type": "integer",
          "minimum": 0
        },
        "live": {
          "type": "integer",
          "minimum": 0
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["linux", "macos", "windows"]
          }
        }
      },
      "additionalProperties": false
    },
    "proofs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "schema",
          "status",
          "source",
          "path",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]*$"
          },
          "category": {
            "type": "string",
            "enum": ["source-control", "live-service", "acceptance"]
          },
          "schema": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "accepted": {
            "type": ["boolean", "null"]
          },
          "live": {
            "type": ["boolean", "null"]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "details": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
