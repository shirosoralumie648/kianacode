{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-release-ops.v1.schema.json",
  "title": "Kiana Release Operations v1",
  "type": "object",
  "required": [
    "schema",
    "version",
    "status",
    "accepted",
    "accepted_by",
    "accepted_at",
    "security_contact",
    "vulnerability_report_channel",
    "release_credentials_owner",
    "support_contact",
    "artifact_retention_days",
    "log_retention_days",
    "credential_review"
  ],
  "properties": {
    "schema": {
      "const": "kiana.release-ops.v1"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["accepted", "local_rc_only", "blocked"]
    },
    "accepted": {
      "type": "boolean"
    },
    "accepted_by": {
      "type": "string"
    },
    "accepted_at": {
      "type": "string"
    },
    "security_contact": {
      "type": "string"
    },
    "vulnerability_report_channel": {
      "type": "string"
    },
    "release_credentials_owner": {
      "type": "string"
    },
    "support_contact": {
      "type": "string"
    },
    "artifact_retention_days": {
      "type": "integer",
      "minimum": 90
    },
    "log_retention_days": {
      "type": "integer",
      "minimum": 30
    },
    "credential_review": {
      "type": "object",
      "required": ["status", "reviewed_by", "reviewed_at", "scope"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["accepted", "pending", "blocked"]
        },
        "reviewed_by": {
          "type": "string"
        },
        "reviewed_at": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
