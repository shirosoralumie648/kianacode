{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-doctor.v1.schema.json",
  "title": "Kiana Doctor Report v1",
  "type": "object",
  "required": [
    "schema",
    "status",
    "cwd",
    "cargo",
    "git_root",
    "config_file",
    "sdk_sessions_dir",
    "api_key_set",
    "model",
    "remote_settings",
    "tui_permission_request",
    "mcp_transport",
    "modifiers",
    "remote_bridge",
    "remote_code_session",
    "oauth_token_file",
    "bash_sandbox",
    "commercial_security",
    "reference_capabilities",
    "warnings"
  ],
  "properties": {
    "schema": {
      "const": "kiana.doctor.v1"
    },
    "status": {
      "type": "string",
      "enum": ["ready", "warning"]
    },
    "cwd": {
      "type": "string"
    },
    "cargo": {
      "$ref": "#/$defs/probe"
    },
    "git_root": {
      "$ref": "#/$defs/probe"
    },
    "config_file": {
      "$ref": "#/$defs/path_status"
    },
    "sdk_sessions_dir": {
      "$ref": "#/$defs/path_status"
    },
    "api_key_set": {
      "type": "boolean"
    },
    "model": {
      "type": "string"
    },
    "remote_settings": {
      "type": "object",
      "required": ["status", "file"],
      "properties": {
        "status": {
          "type": "string"
        },
        "file": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "tui_permission_request": {
      "type": "object",
      "required": ["active", "queued"],
      "properties": {
        "active": {
          "type": "boolean"
        },
        "queued": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "mcp_transport": {
      "type": "object",
      "required": ["wired", "transports", "surfaces"],
      "properties": {
        "wired": {
          "type": "boolean"
        },
        "transports": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "surfaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "modifiers": {
      "type": "object",
      "required": ["platform", "backend", "available", "current"],
      "properties": {
        "platform": {
          "type": "string"
        },
        "backend": {
          "type": "string"
        },
        "available": {
          "type": "boolean"
        },
        "current": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "remote_bridge": {
      "type": "object",
      "required": ["start_command_wired", "token_configured"],
      "properties": {
        "start_command_wired": {
          "type": "boolean"
        },
        "token_configured": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "remote_code_session": {
      "type": "object",
      "required": ["live_smoke_token", "configured", "source"],
      "properties": {
        "live_smoke_token": {
          "type": "string"
        },
        "configured": {
          "type": "boolean"
        },
        "source": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "oauth_token_file": {
      "type": "object",
      "required": ["status", "valid", "refreshable", "error"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["missing", "access_only", "refreshable", "invalid"]
        },
        "valid": {
          "type": "boolean"
        },
        "refreshable": {
          "type": "boolean"
        },
        "error": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "bash_sandbox": {
      "type": "object",
      "required": [
        "enabled",
        "status",
        "runtime",
        "fail_if_unavailable",
        "allow_unsandboxed_commands",
        "bwrap"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "status": {
          "type": "string"
        },
        "runtime": {
          "type": "string"
        },
        "fail_if_unavailable": {
          "type": "boolean"
        },
        "allow_unsandboxed_commands": {
          "type": "boolean"
        },
        "bwrap": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "commercial_security": {
      "type": "object",
      "required": ["ready", "status", "platform", "isolation", "controls", "issues"],
      "properties": {
        "ready": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": ["ready", "not_ready"]
        },
        "platform": {
          "type": "string"
        },
        "isolation": {
          "type": "string",
          "enum": [
            "linux_bwrap",
            "windows_exec_policy",
            "macos_exec_policy",
            "unsupported_platform"
          ]
        },
        "controls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "reference_capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/reference_capability"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "probe": {
      "type": "object",
      "required": ["available", "value"],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "value": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "path_status": {
      "type": "object",
      "required": ["path", "found"],
      "properties": {
        "path": {
          "type": "string"
        },
        "found": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "reference_capability": {
      "type": "object",
      "required": ["id", "domain", "status", "references", "surfaces", "evidence", "risks"],
      "properties": {
        "id": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["ready", "not_ready", "in_progress", "local_ready_external_required", "external_required"]
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "surfaces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
