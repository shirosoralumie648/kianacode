{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kiana.local/schemas/kiana-local-rc-evidence.v1.schema.json",
  "title": "Kiana Local RC Evidence v1",
  "type": "object",
  "required": [
    "schema",
    "version",
    "generated_at",
    "status",
    "dist_dir",
    "summary",
    "release_artifacts",
    "distribution_manifests",
    "readiness",
    "proofs",
    "blockers"
  ],
  "properties": {
    "schema": { "const": "kiana.local-rc-evidence.v1" },
    "version": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["local_rc_ready", "local_rc_incomplete"] },
    "dist_dir": { "type": "string", "minLength": 1 },
    "summary": {
      "type": "object",
      "required": [
        "release_artifacts",
        "manifests",
        "proofs",
        "blockers_total",
        "local_blockers",
        "external_blockers"
      ],
      "properties": {
        "release_artifacts": { "type": "integer", "minimum": 0 },
        "manifests": { "type": "integer", "minimum": 0 },
        "proofs": { "type": "integer", "minimum": 0 },
        "blockers_total": { "type": "integer", "minimum": 0 },
        "local_blockers": { "type": "integer", "minimum": 0 },
        "external_blockers": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "release_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["target", "archive", "archive_sha256", "binary_sha256", "lifecycle_smoke"],
        "properties": {
          "target": { "type": "string", "minLength": 1 },
          "archive": { "type": "string", "minLength": 1 },
          "archive_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "binary_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "lifecycle_smoke": { "type": "string", "enum": ["passed", "not_run"] }
        },
        "additionalProperties": false
      }
    },
    "distribution_manifests": {
      "type": "object",
      "required": ["enterprise_offline_manifest", "homebrew_formulae", "winget_manifests", "blocked_channels"],
      "properties": {
        "enterprise_offline_manifest": { "type": "string" },
        "homebrew_formulae": { "type": "array", "items": { "type": "string" } },
        "winget_manifests": { "type": "array", "items": { "type": "string" } },
        "blocked_channels": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "readiness": {
      "type": "object",
      "required": [
        "ready",
        "release_artifacts_present",
        "lifecycle_smoke_passed",
        "required_proofs_present",
        "local_blockers_clear",
        "required_proof_schemas",
        "issues"
      ],
      "properties": {
        "ready": { "type": "boolean" },
        "release_artifacts_present": { "type": "boolean" },
        "lifecycle_smoke_passed": { "type": "boolean" },
        "required_proofs_present": { "type": "boolean" },
        "local_blockers_clear": { "type": "boolean" },
        "required_proof_schemas": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "required": ["schema", "present", "paths"],
            "properties": {
              "schema": {
                "type": "string",
                "enum": [
                  "kiana.source-control-proof.v1",
                  "kiana.product-acceptance.v1",
                  "kiana.entitlement-proof.v1",
                  "kiana.release-ops.v1",
                  "kiana.platform-security-proof.v1"
                ]
              },
              "present": { "type": "boolean" },
              "paths": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              }
            },
            "additionalProperties": false
          }
        },
        "issues": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "proofs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "schema", "status", "accepted"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "schema": { "type": "string" },
          "status": { "type": "string" },
          "accepted": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "blockers": {
      "type": "object",
      "required": [
        "status",
        "blocking",
        "local_blocking",
        "external_blocking",
        "blocking_ids",
        "external_blocking_ids",
        "handoff_status",
        "handoff_artifacts"
      ],
      "properties": {
        "status": { "type": "string", "enum": ["ready", "blocked"] },
        "blocking": { "type": "integer", "minimum": 0 },
        "local_blocking": { "type": "integer", "minimum": 0 },
        "external_blocking": { "type": "integer", "minimum": 0 },
        "blocking_ids": { "type": "array", "items": { "type": "string" } },
        "external_blocking_ids": { "type": "array", "items": { "type": "string" } },
        "handoff_status": {
          "type": "string",
          "enum": ["external_action_required", "not_required"]
        },
        "handoff_artifacts": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["kind", "path", "sha256"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["blockers_json", "handoff_markdown"]
              },
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
            },
            "additionalProperties": false
          },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "properties": {
                  "kind": { "const": "blockers_json" }
                },
                "required": ["kind"]
              }
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "kind": { "const": "handoff_markdown" }
                },
                "required": ["kind"]
              }
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": { "const": "local_rc_ready" }
        }
      },
      "then": {
        "properties": {
          "readiness": {
            "properties": {
              "ready": { "const": true }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": { "const": "local_rc_incomplete" }
        }
      },
      "then": {
        "properties": {
          "readiness": {
            "properties": {
              "ready": { "const": false }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
