{
  "schema": "kiana.web-route-matrix.v1",
  "binding": {
    "listener": "loopback-only",
    "host": "exact-bound-address",
    "origin": "exact-http-origin-when-present",
    "token_header": "x-kiana-web-token",
    "sse_token_query": "explicit-eventsource-compatibility",
    "token_rotation_schema": "kiana.web-token-rotation.v1",
    "method_rejection": "axum-method-rejection-before-handler"
  },
  "limits": {
    "body_bytes": 131072,
    "uri_bytes": 8192,
    "requests_per_window": 120,
    "window_ms": 1000
  },
  "page_route": {
    "path": "/",
    "method": "GET",
    "class": "page",
    "token_required": false,
    "host_only": true
  },
  "host_only_routes": [
    "/",
    "/api/health",
    "/api/csp-report"
  ],
  "methods": {
    "registered": [
      "GET",
      "POST"
    ],
    "denied_without_handler": [
      "OPTIONS",
      "PUT",
      "DELETE",
      "PATCH",
      "TRACE"
    ],
    "wrong_method_status": 405,
    "options_rejected_status": 405
  },
  "token_rotation": {
    "route": "/api/token/rotate",
    "schema": "kiana.web-token-rotation.v1",
    "echoes_credential": false,
    "generation_monotonic": true,
    "invalidates_previous_credential": true,
    "rehydrate_route": "/",
    "principal_changed": false,
    "lease_changed": false
  },
  "security_headers": [
    [
      "x-content-type-options",
      "nosniff"
    ],
    [
      "cache-control",
      "no-store"
    ],
    [
      "referrer-policy",
      "no-referrer"
    ],
    [
      "x-frame-options",
      "DENY"
    ]
  ],
  "csp": {
    "template": "default-src 'self'; script-src 'nonce-{nonce}'; style-src 'nonce-{nonce}'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; report-uri /api/csp-report",
    "nonce_placeholder": "{nonce}",
    "report_uri": "/api/csp-report",
    "unsafe_inline": false,
    "eval": false,
    "header": "content-security-policy"
  },
