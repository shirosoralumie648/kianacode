{
  "schema": "kiana.web-artifact-detail.v1",
  "scope_schema": "kiana.ui-detail-scope.v1",
  "artifact_ref_schema": "kiana.ui-artifact-ref.v1",
  "artifact_page_schema": "kiana.ui-artifact-page.v2",
  "diff_schema": "kiana.web-diff-detail.v1",
  "receipt_schema": "kiana.web-receipt-detail.v1",
  "server_fields": [
    "artifact_id",
    "version",
    "content_hash",
    "mime",
    "size_bytes",
    "revision",
    "provenance",
    "page_digest",
    "total_additions",
    "total_deletions",
    "receipt_digest",
    "limitations",
    "content_encoding",
    "truncated",
    "unknown"
  ],
  "deny_first": [
    "client_payload_mutation",
    "stale_artifact_revision",
    "page_digest_mismatch",
    "content_missing_never_ready",
    "cross_session_artifact_enumeration",
    "cross_tab_cursor_scope",
    "cursor_replay",
    "unknown_result_green_success",
    "result_unknown_auto_retry",
    "raw_secret_leak",
    "raw_path_leak",
    "html_svg_ansi_injection",
    "client_computed_diff",
    "arbitrary_url_fetch",
    "expired_server_cursor",
    "partial_file_approval_refused",
    "unsupported_receipt_cursor"
  ],
  "success": [
    "server_artifact_ref",
    "bounded_page_cursor",
    "server_diff_stats",
    "timeline_diff_receipt_links",
    "receipt_digest_projection",
    "partial_binary_redacted_page",
    "unknown_visible",
    "binary_artifact_limitation",
    "oversized_artifact_limitation",
    "typed_receipt_digest"
  ],
  "authority": "Web read-only projection -> DaemonHost -> EventLog/Receipt facts",
  "proof_level": "local_behavior",
  "limitations": [
    "artifact bytes are never served by the read-only projection",
    "receipt detail is a typed run_receipt projection, not a second authority",
    "diff statistics are server-owned and currently reported unavailable"
  ]
}
