    {
      "name": "arrival_order_never_overwrites_a_recorded_error",
      "epoch": "daemon-ui13",
      "events": [
        {
          "sequence": 1,
          "event": {
            "type": "error",
            "run_id": "00000000-0000-0000-0000-000000000013",
            "data": {"code": "provider_timeout", "retry": false}
          }
        },
        {
          "sequence": 2,
          "event": {
            "type": "delta",
            "run_id": "00000000-0000-0000-0000-000000000013",
            "text": "late text must not replace the error"
          }
        }
      ],
      "expected_kinds": ["Error", "Delta"],
      "expected_cursor": 2,
      "expected_terminal": false,
      "expect_bodies_contain": [
        {"kind": "Error", "text": "provider_timeout"},
        {"kind": "Delta", "text": "late text must not replace the error"}
      ],
      "expect_bodies_exclude": [
        {"kind": "Error", "text": "late text must not replace the error"}
      ]
    },
