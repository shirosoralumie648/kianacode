{
  "schema": "kiana.ui14-workbench-controller.v1",
  "step": "UI-14",
  "source": "pure Workbench controller: intent -> WorkbenchUiAction -> UiActionV1; keymap, command palette and session switcher; no daemon, transport, broker or effect authority",
  "budgets": {
    "max_sessions": 256,
    "max_palette_entries": 32,
    "max_audit_entries": 128,
    "max_text_bytes": 65536,
    "max_target_bytes": 256,
    "max_title_bytes": 512,
    "commands": 9,
    "shortcuts": 8
  },
  "commands": [
    "workbench.open",
    "workbench.attach",
    "workbench.new",
    "workbench.continue",
    "workbench.status",
    "workbench.run",
    "workbench.cancel",
    "workbench.resume",
    "workbench.receipt"
  ],
  "keymap": [
    {"shortcut": "Ctrl+o", "command": "workbench.open"},
    {"shortcut": "Ctrl+a", "command": "workbench.attach"},
    {"shortcut": "Ctrl+n", "command": "workbench.new"},
    {"shortcut": "Ctrl+k", "command": "workbench.status"},
    {"shortcut": "Ctrl+r", "command": "workbench.run"},
    {"shortcut": "Ctrl+c", "command": "workbench.cancel"},
    {"shortcut": "Ctrl+u", "command": "workbench.resume"},
    {"shortcut": "Ctrl+e", "command": "workbench.receipt"}
  ],
  "cas_fields": [
    "command_id",
    "idempotency_key",
    "target_id",
    "expected_epoch",
    "expected_cursor",
    "expected_revision",
    "submitted_by"
  ],
  "intents": [
    {
      "intent": "open",
      "command": "workbench.open",
      "target": "workspace",
      "payload_keys": ["workspace"],
      "mutating": true,
      "clears_draft": true
    },
    {
      "intent": "attach",
      "command": "workbench.attach",
      "target": "session_id",
      "payload_keys": ["session_id"],
      "mutating": true,
      "clears_draft": true
    },
    {
      "intent": "new",
      "command": "workbench.new",
      "target": "workspace",
      "payload_keys": ["title"],
      "mutating": true,
      "clears_draft": true
    },
    {
      "intent": "continue",
      "command": "workbench.continue",
      "target": "active_session",
      "payload_keys": ["prompt", "run_id"],
      "mutating": true,
      "clears_draft": false
    },
    {
      "intent": "status",
      "command": "workbench.status",
      "target": "active_session",
      "payload_keys": ["session_id"],
      "mutating": false,
      "clears_draft": false
    },
    {
      "intent": "run",
      "command": "workbench.run",
      "target": "active_session",
      "payload_keys": ["prompt"],
      "mutating": true,
      "clears_draft": false
    },
    {
      "intent": "cancel",
      "command": "workbench.cancel",
      "target": "active_session",
      "payload_keys": ["run_id"],
      "mutating": true,
      "clears_draft": false
    },
    {
      "intent": "resume",
      "command": "workbench.resume",
      "target": "active_session",
      "payload_keys": ["run_id"],
      "mutating": true,
      "clears_draft": false
    },
    {
      "intent": "receipt",
      "command": "workbench.receipt",
      "target": "active_session",
      "payload_keys": ["run_id"],
      "mutating": false,
      "clears_draft": false
    }
  ],
  "scenarios": [
    {
      "name": "session-switch-cannot-reuse-the-previous-draft",
      "fixture": "session_switch_cannot_submit_the_previous_draft_and_targets_the_new_session",
      "refusals": ["stale_draft"]
    },
    {
      "name": "duplicate-shortcut-cannot-yield-two-commands",
      "fixture": "keymap_and_palette_reject_duplicate_shortcuts_and_hide_missing_capabilities",
      "refusals": ["duplicate_shortcut", "duplicate_command_binding"]
    },
    {
      "name": "missing-capability-hides-and-refuses-actions",
      "fixture": "denied_intents_leave_no_action_no_sequence_and_no_audit_entry",
      "refusals": ["capability_unavailable", "workbench_controller_offline"]
    },
    {
      "name": "multi-session-targets-stay-bound-to-the-selected-session",
      "fixture": "multi_session_targets_stay_bound_to_the_selected_session",
      "refusals": ["session_switcher_session_missing"]
    },
    {
      "name": "duplicate-submit-cannot-mint-a-second-command",
      "fixture": "stale_draft_and_duplicate_submission_are_rejected_before_action_creation",
      "refusals": ["duplicate_submission"]
    },
    {
      "name": "disconnect-keeps-the-original-identity-and-blocks-new-mutations",
      "fixture": "connection_loss_marks_the_submission_unknown_with_its_original_identity",
      "refusals": ["action_result_command_mismatch"]
    },
    {
      "name": "lost-response-requires-reconciliation-of-the-original-command",
      "fixture": "response_loss_never_mints_a_second_command_and_survives_a_terminal_run",
      "refusals": ["duplicate_submission"]
    },
    {
      "name": "stale-card-results-are-rejected",
      "fixture": "stale_card_results_are_rejected_and_never_resurrect_a_submission",
      "refusals": ["action_result_without_submission", "action_result_command_mismatch"]
    },
    {
      "name": "sigterm-is-not-a-window-close-or-a-cancel",
      "fixture": "termination_signals_are_not_window_close_cancel_or_resume",
      "refusals": ["workbench_controller_terminating"]
    },
    {
      "name": "restart-recovery-refuses-stale-or-foreign-coordinates",
      "fixture": "restart_recovery_refuses_stale_widened_or_foreign_coordinates",
      "refusals": ["workbench_recovery_cursor_stale", "workbench_recovery_revision_stale"]
    },
    {
      "name": "restart-recovery-carries-only-coordinates-and-the-unreconciled-identity",
      "fixture": "restart_recovery_carries_only_server_coordinates_and_the_unreconciled_identity",
      "refusals": ["duplicate_submission"]
    },
    {
      "name": "window-close-keeps-run-and-submission-dimensions-separate",
      "fixture": "window_close_detaches_without_implicit_cancel_or_resume",
      "refusals": ["workbench_controller_closed"]
    }
  ],
  "recovery": {
    "observation_fields": [
      "workspace",
      "principal",
      "epoch",
      "cursor",
      "revision",
      "connection",
      "sessions",
      "active_session_id",
      "capabilities"
    ],
    "not_carried": ["draft", "submission_status", "in_flight_action", "run_status"],
    "carried": ["unreconciled-submission-identity", "idempotency-sequence", "draft-revision-floor"]
  },
  "fixtures": [
    "fixture_commands_keymap_and_deny_matrix_are_wired",
    "every_declared_intent_translates_to_its_stable_action",
    "controller_translates_actions_with_scope_and_preserves_separate_statuses",
    "open_action_respects_wire_target_and_idempotency_bounds",
    "stale_draft_and_duplicate_submission_are_rejected_before_action_creation",
    "session_switcher_clears_old_draft_before_new_session_action",
    "session_switch_cannot_submit_the_previous_draft_and_targets_the_new_session",
    "keymap_and_palette_reject_duplicate_shortcuts_and_hide_missing_capabilities",
    "denied_intents_leave_no_action_no_sequence_and_no_audit_entry",
    "window_close_detaches_without_implicit_cancel_or_resume",
    "all_required_intents_have_stable_command_names",
    "multi_session_targets_stay_bound_to_the_selected_session",
    "connection_loss_marks_the_submission_unknown_with_its_original_identity",
    "response_loss_never_mints_a_second_command_and_survives_a_terminal_run",
    "stale_card_results_are_rejected_and_never_resurrect_a_submission",
    "termination_signals_are_not_window_close_cancel_or_resume",
    "restart_recovery_refuses_stale_widened_or_foreign_coordinates",
    "restart_recovery_carries_only_server_coordinates_and_the_unreconciled_identity",
    "restart_recovery_without_a_pending_submission_starts_idle_and_allows_work",
    "hostile_control_traffic_keeps_the_controller_bounded_and_audit_append_only",
    "declared_scenarios_are_exercised_by_their_named_fixtures"
  ],
  "required": [
    "session-switch-cannot-reuse-the-previous-draft",
    "duplicate-shortcut-cannot-yield-two-commands",
    "missing-capability-hides-and-refuses-actions",
    "window-close-never-cancels-or-resumes",
    "multi-session-targets-stay-bound-to-the-selected-session",
    "duplicate-submit-cannot-mint-a-second-command",
    "disconnect-marks-the-submission-unknown-with-its-original-identity",
    "lost-response-is-reconciled-by-the-original-command-id-only",
    "stale-card-results-are-rejected",
    "sigterm-is-not-a-window-close-or-a-cancel",
    "restart-recovery-carries-only-server-coordinates",
    "restart-recovery-continues-the-idempotency-sequence",
    "action-audit-trace-is-bounded-and-append-only",
    "submission-state-and-run-state-stay-separate",
    "controller-owns-no-transport-or-effect-authority"
  ],
  "denied": [
    "workbench_controller_scope_invalid",
    "workbench_controller_cursor_invalid",
    "workbench_controller_closed",
    "workbench_controller_offline",
    "workbench_controller_terminating",
    "workbench_recovery_offline",
    "workbench_recovery_scope_changed",
    "workbench_recovery_epoch_mismatch",
    "workbench_recovery_cursor_stale",
    "workbench_recovery_revision_stale",
    "workbench_recovery_session_changed",
    "workbench_draft_invalid",
    "workbench_intent_invalid",
    "stale_draft",
    "duplicate_submission",
    "duplicate_shortcut",
    "duplicate_command_binding",
    "command_palette_size_invalid",
    "command_palette_label_invalid",
    "command_palette_capability_invalid",
    "command_palette_duplicate_command",
    "session_switcher_limit",
    "session_switcher_duplicate_session",
    "session_switcher_active_missing",
    "session_switcher_session_missing",
    "capability_unavailable",
    "run_required",
    "action_result_without_submission",
    "action_result_command_mismatch"
  ],
  "propagated_denials": [
    "ui_action_idempotency_key",
    "ui_action_target",
    "ui_action_revision_invalid",
    "ui_action_payload_digest_mismatch",
    "ui_capability_schema_invalid",
    "ui_cursor_invalid"
  ],
  "denial_templates": {
    "workbench_{field}_invalid": ["workspace", "session_id", "title", "prompt"]
  },
  "limitations": [
    "process-local disposable intent adapter; it sends nothing and owns no transport",
    "the typed client still computes and validates the canonical payload digest before UiActionV1",
    "authorization, CAS, idempotency deduplication and effect evidence remain DaemonHost/ControlPlane facts",
    "the audit trace is a bounded local view, not an EventLog projection or a durable journal",
    "recovery is a read-only contract over server-observed coordinates; no cross-process persistence, SIGTERM handler or live terminal is claimed"
  ]
}
